---
import Base from '../../layouts/Base.astro';
import Team from '../../components/Team.astro';
import ScoreBug from '../../components/ScoreBug.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import DataCredit from '../../components/DataCredit.astro';
import Abbr from '../../components/Abbr.astro';
import { type Lang, langPaths, useT, href, url, formatDate } from '../../i18n/index.ts';
import { TEAM, isOurTeam } from '../../config/team.ts';
import { currentSeasonId, season, ourGames, sortByDate, highlights, derived, teamName, ourScore, resultCode, resultClass, games, side } from '../../lib/data.ts';
import { newsFor, newsSlug } from '../../lib/news.ts';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang);

const all = sortByDate(ourGames());
// Candidates for "next game"; the client script picks the first one still in the future.
const upcoming = all.filter((g) => g.status === 'scheduled' && g.timestamp != null && g.timestamp > Date.now() - 3 * 3600_000).slice(0, 4);
const results = [...all].reverse().filter((g) => g.status === 'final').slice(0, 10);
const lastResult = results[0];
const latestVideo = highlights.items[0];
const cur = season(currentSeasonId);
const standings = cur ? [...cur.standings].reverse().find((s) => s.rows.some((r) => isOurTeam(r.team))) : undefined;
const recap = (await newsFor(lang))[0];
const top = derived.players
  .map((p) => ({ p, l: p.seasons.find((s) => s.season === currentSeasonId) }))
  .filter((x) => x.l && x.l.gp > 0)
  .sort((a, b) => b.l!.p - a.l!.p || b.l!.g - a.l!.g)
  .slice(0, 5);
const last = lastResult ? { ...ourScore(lastResult), r: resultCode(lastResult) } : null;
// Goal summary for the last result (shown on desktop only).
const lastReport = lastResult ? games.get(lastResult.id) : undefined;
const lastGoals = lastReport?.goals ?? [];
const lastSide = lastResult ? side(lastResult) : 'home';
const seasonLabel = currentSeasonId.replace('-', '/');
// Skate scratches for the center-ice hero texture (fixed seed → identical on every build).
let seed = 7;
const rnd = () => (seed = (seed * 9301 + 49297) % 233280) / 233280;
const scratches = Array.from({ length: 46 }, () => {
  const x = rnd() * 1400;
  const y = rnd() * 560;
  const len = 120 + rnd() * 420;
  const bend = (rnd() - 0.5) * 140;
  const ang = (rnd() - 0.5) * 0.6;
  const x2 = x + Math.cos(ang) * len;
  const y2 = y + Math.sin(ang) * len;
  return {
    d: `M${x.toFixed(0)} ${y.toFixed(0)} Q ${((x + x2) / 2).toFixed(0)} ${((y + y2) / 2 + bend).toFixed(0)} ${x2.toFixed(0)} ${y2.toFixed(0)}`,
    o: (0.03 + rnd() * 0.06).toFixed(3),
    w: (0.6 + rnd() * 1.2).toFixed(1),
  };
});
import CalendarButton from '../../components/CalendarButton.astro';
---

<Base lang={lang} path="" active="nav.home" leagueData>
  <!-- HERO: next game scoreboard -->
  <section class="hero" aria-labelledby="h-next">
    <svg class="rink" viewBox="0 0 1400 560" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <g class="scratches">
        {scratches.map((s) => <path d={s.d} stroke="currentColor" stroke-opacity={s.o} stroke-width={s.w} fill="none" />)}
      </g>
      <line x1="700" y1="0" x2="700" y2="560" stroke="rgba(232,180,20,0.22)" stroke-width="5"></line>
      <line x1="700" y1="0" x2="700" y2="560" stroke="currentColor" stroke-opacity="0.05" stroke-width="1" stroke-dasharray="14 10"></line>
      <line x1="330" y1="0" x2="330" y2="560" stroke="rgba(42,65,139,0.45)" stroke-width="9"></line>
      <line x1="1070" y1="0" x2="1070" y2="560" stroke="rgba(42,65,139,0.45)" stroke-width="9"></line>
      <circle cx="700" cy="280" r="190" stroke="currentColor" stroke-opacity="0.09" stroke-width="2" fill="none"></circle>
      <circle cx="700" cy="280" r="7" fill="rgba(42,65,139,0.7)"></circle>
      <circle cx="190" cy="140" r="5" fill="rgba(232,180,20,0.4)"></circle>
      <circle cx="190" cy="420" r="5" fill="rgba(232,180,20,0.4)"></circle>
      <circle cx="1210" cy="140" r="5" fill="rgba(232,180,20,0.4)"></circle>
      <circle cx="1210" cy="420" r="5" fill="rgba(232,180,20,0.4)"></circle>
    </svg>
    <img
      class="hero-photo"
      src={url('hero/team-2025-1280.webp')}
      srcset={`${url('hero/team-2025-768.webp')} 768w, ${url('hero/team-2025-1280.webp')} 1280w`}
      sizes="100vw"
      width="1280"
      height="711"
      alt=""
      fetchpriority="high"
      decoding="async"
      onerror="this.remove()"
    />
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="hero-inner">
      <p class="hero-top rise">
        <span class="tag" id="h-next">{t('home.nextGame')}</span>
        <span class="season">{TEAM.leagueName} · {seasonLabel}</span>
      </p>

      {
        upcoming.map((g, i) => (
          <div class="next-game" data-ts={g.timestamp} hidden={i > 0}>
            <div class="matchup rise rise-2">
              {(['home', 'away'] as const).map((s, idx) => {
                const team = s === 'home' ? g.home : g.away;
                return (
                  <>
                    {idx === 1 && <span class="vs">VS</span>}
                    <div class={`side ${isOurTeam(team) ? 'us' : ''}`}>
                      <Team team={team} logoOnly size={68} />
                      <span class="code">{team.short || teamName(team).slice(0, 3)}</span>
                      <span class="full">{teamName(team)}</span>
                    </div>
                  </>
                );
              })}
            </div>
            <p class="when rise rise-3">
              <strong>{formatDate(lang, g.date, { weekday: true })}</strong>
              <span class="dot">·</span>
              <strong>{g.time ?? t('common.tbd')}</strong>
              <span class="where">{g.venue?.replace(/^Wien - /, '')}</span>
            </p>
            <div class="countdown rise rise-3" data-countdown={g.timestamp} aria-label={t('home.countdown')}>
              {[
                ['d', t('home.days')],
                ['h', t('home.hours')],
                ['m', t('home.minutes')],
                ['s', lang === 'de' ? 'Sek' : 'sec'],
              ].map(([k, label]) => (
                <span class="seg-digit">
                  <span class="v tnum" data-unit={k}>
                    --
                  </span>
                  <span class="k">{label}</span>
                </span>
              ))}
            </div>
          </div>
        ))
      }

      <div class="no-next" hidden={upcoming.length > 0}>
        <p class="muted">{t('home.noNextGame')}</p>
      </div>

      <div class="hero-cta">
        {upcoming[0] && <CalendarButton lang={lang} game={upcoming[0]} />}
        {upcoming[0] ? (
          <a class="btn btn-ghost" href={href(lang, `games/${upcoming[0].id}/`)}>{lang === 'de' ? 'Vorschau' : 'Preview'} →</a>
        ) : (
          <a class="btn btn-ghost" href={href(lang, 'schedule/')}>{t('nav.schedule')}</a>
        )}
      </div>
    </div>
    <div class="hero-band" aria-hidden="true"></div>
  </section>

  <!-- TICKER: latest results -->
  {
    results.length > 0 && (
      <section aria-labelledby="h-results">
        <div class="sec-head">
          <h2 id="h-results">{t('home.results')}</h2>
          <a href={href(lang, 'schedule/')}>{t('common.viewAll')}</a>
        </div>
        <div class="ticker" tabindex="0" aria-label={t('home.results')}>
          {results.map((g) => (
            <ScoreBug lang={lang} game={g} />
          ))}
        </div>
      </section>
    )
  }

  <!-- LAST RESULT big + highlight -->
  <div class="duo stretch">
    {
      lastResult && last && (
        <a class="panel last" href={href(lang, `games/${lastResult.id}/`)}>
          <p class="eyebrow">{t('common.final')} · {formatDate(lang, lastResult.date)}</p>
          <div class="last-score">
            <Team team={lastResult.home} logoOnly size={44} />
            <span class="big tnum">
              {lastResult.homeScore}
              <i>:</i>
              {lastResult.awayScore}
            </span>
            <Team team={lastResult.away} logoOnly size={44} />
          </div>
          <p class="last-teams">
            {teamName(lastResult.home)} <span class="dim">vs</span> {teamName(lastResult.away)}
          </p>
          {last.r && <span class={`res res-${resultClass(last.r)}`}>{last.r}</span>}
          {lastGoals.length > 0 && (
            <div class="goal-sum" aria-label={t('game.goals')}>
              <ol>
                {lastGoals.map((goal, i) => (
                  <>
                    {(i === 0 || lastGoals[i - 1].period !== goal.period) && (
                      <li class="per">{/^\d+$/.test(goal.period) ? `${goal.period}. ${t('common.period')}` : goal.period}</li>
                    )}
                    <li class={goal.team === lastSide ? 'us' : 'them'}>
                      <span class="gt tnum">{goal.timeLabel}</span>
                      <span class="gw">
                        <span class="gn">{goal.scorer ? `${goal.scorer.first.charAt(0)}. ${goal.scorer.last}` : '–'}</span>
                        {goal.assists.length > 0 && (
                          <span class="ga2">{goal.assists.map((a) => `${a.first.charAt(0)}. ${a.last}`).join(', ')}</span>
                        )}
                        {(goal.situation !== 'EQ' || goal.gwg) && (
                          <span class="gtags">
                            {goal.situation !== 'EQ' && <span class="gtag">{t(`situation.${goal.situation}`)}</span>}
                            {goal.gwg && <span class="gtag gwg">{t('game.gwg')}</span>}
                          </span>
                        )}
                      </span>
                      <span class="gs tnum">{goal.score}</span>
                    </li>
                  </>
                ))}
              </ol>
              <span class="goal-more">{t('game.title')} →</span>
            </div>
          )}
        </a>
      )
    }
    {
      latestVideo && (
        <section class="panel media" aria-labelledby="h-video">
          <p class="eyebrow" id="h-video">
            {t('home.latestHighlight')}
          </p>
          <VideoEmbed lang={lang} video={latestVideo.video} />
          {latestVideo.gameId && (
            <p class="small media-link">
              <a href={href(lang, `games/${latestVideo.gameId}/`)}>{t('highlights.toGame')} →</a>
            </p>
          )}
        </section>
      )
    }
  </div>

  <div class="duo">
    <!-- STANDINGS -->
    <section aria-labelledby="h-table">
      <div class="sec-head">
        <h2 id="h-table">{t('home.standings')}</h2>
        <a href={href(lang, 'standings/')}>{t('home.fullTable')}</a>
      </div>
      {standings && <p class="eyebrow">{standings.divisionName}</p>}
      {
        standings ? (
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th class="num" scope="col"><Abbr lang={lang} k="rank" /></th>
                  <th scope="col">{t('common.team')}</th>
                  <th class="num" scope="col"><Abbr lang={lang} k="gp" /></th>
                  <th class="num" scope="col"><Abbr lang={lang} k="gd" /></th>
                  <th class="num" scope="col"><Abbr lang={lang} k="pts" /></th>
                </tr>
              </thead>
              <tbody>
                {standings.rows.map((r) => (
                  <tr class={isOurTeam(r.team) ? 'ours' : undefined}>
                    <td class="num rank">{r.rank}</td>
                    <td class="team-cell">
                      <Team team={r.team} />
                    </td>
                    <td class="num">{r.gp}</td>
                    <td class="num">{r.gd > 0 ? `+${r.gd}` : r.gd}</td>
                    <td class="num big">{r.pts}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <p class="missing">{t('common.missing')}</p>
        )
      }
    </section>

    <!-- LEADERS -->
    <section aria-labelledby="h-top">
      <div class="sec-head">
        <h2 id="h-top">{t('home.topScorers')}</h2>
        <a href={href(lang, 'stats/')}>{t('home.allStats')}</a>
      </div>
      {
        top.length ? (
          <ol class="rows leaders">
            {top.map(({ p, l }, i) => (
              <li>
                <a href={href(lang, `players/${p.slug}/`)} class={i === 0 ? 'first' : undefined}>
                  <span class="rk tnum">{i + 1}</span>
                  <span class="nm">
                    <span class="fn">{p.first}</span>
                    <span class="ln">{p.last}</span>
                  </span>
                  <span class="ga tnum">
                    {l!.gp}
                    <Abbr lang={lang} k="gp" /> · {l!.g}
                    <Abbr lang={lang} k="g" /> · {l!.a}
                    <Abbr lang={lang} k="a" />
                  </span>
                  <span class="pt tnum">
                    {l!.p}
                    <small>
                      <Abbr lang={lang} k="p" />
                    </small>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        ) : (
          <p class="missing">{t('common.missing')}</p>
        )
      }
    </section>
  </div>

  {
    recap && (
      <section aria-labelledby="h-recap">
        <div class="sec-head">
          <h2 id="h-recap">{t('home.latestRecap')}</h2>
          <a href={href(lang, 'news/')}>{t('common.viewAll')}</a>
        </div>
        <a class="panel recap" href={href(lang, `news/${newsSlug(recap)}/`)}>
          <p class="eyebrow">{formatDate(lang, recap.data.date.toISOString())}</p>
          <h3>{recap.data.title}</h3>
          {recap.data.summary && <p class="muted">{recap.data.summary}</p>}
        </a>
      </section>
    )
  }

  <!-- JOIN band -->
  <section class="join-band" aria-labelledby="h-join">
    <div>
      <span class="tag">{t('nav.join')}</span>
      <h2 id="h-join">{t('home.joinTitle')}</h2>
      <p>{t('home.joinText')}</p>
    </div>
    <a class="btn btn-accent" href={href(lang, 'join/')}>{t('nav.join')} →</a>
  </section>

  <DataCredit lang={lang} video={!!latestVideo} />
</Base>

<script>
  const pad = (n: number) => String(n).padStart(2, '0');
  function tick() {
    const now = Date.now();
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.next-game'));
    let shown: HTMLElement | null = null;
    for (const c of cards) {
      const show = !shown && Number(c.dataset.ts) > now;
      c.hidden = !show;
      if (show) shown = c;
    }
    const none = document.querySelector<HTMLElement>('.no-next');
    if (none) none.hidden = !!shown;
    if (!shown) return;
    const diff = Math.max(0, Number(shown.dataset.ts) - now);
    const vals: Record<string, number> = {
      d: Math.floor(diff / 86400000),
      h: Math.floor((diff % 86400000) / 3600000),
      m: Math.floor((diff % 3600000) / 60000),
      s: Math.floor((diff % 60000) / 1000),
    };
    shown.querySelectorAll<HTMLElement>('[data-unit]').forEach((el) => {
      el.textContent = pad(vals[el.dataset.unit!]);
    });
  }
  tick();
  setInterval(tick, 1000);
</script>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    margin: 0 calc(-1 * var(--gutter));
    padding: 1.6rem var(--gutter) 1.4rem;
    overflow: hidden;
    color: var(--text);
    background:
      radial-gradient(70% 90% at 50% 50%, rgba(188, 204, 234, 0.06), transparent 70%),
      linear-gradient(165deg, var(--hero-a) 0%, var(--hero-b) 60%, var(--bg) 100%);
  }
  /* Team photo (Rob Kona). Darkened in dark mode, washed to ice in light mode, so the scoreboard stays readable. */
  .hero-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 38%;
    pointer-events: none;
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(120% 70% at 50% 55%, rgba(var(--bg-rgb), 0.55), rgba(var(--bg-rgb), 0.82) 70%),
      linear-gradient(180deg, rgba(var(--bg-rgb), 0.55) 0%, rgba(var(--bg-rgb), 0.35) 35%, rgba(var(--bg-rgb), 0.92) 100%);
  }
  :global(html[data-theme='light']) .hero-scrim {
    background:
      radial-gradient(120% 70% at 50% 55%, rgba(var(--bg-rgb), 0.72), rgba(var(--bg-rgb), 0.88) 70%),
      linear-gradient(180deg, rgba(var(--bg-rgb), 0.7) 0%, rgba(var(--bg-rgb), 0.55) 35%, rgba(var(--bg-rgb), 0.96) 100%);
  }
  :global(html[data-theme='light']) .hero-photo {
    filter: grayscale(0.35) contrast(0.9);
  }
  /* Center ice: faint rink markings + skate scratches behind the matchup. */
  .rink {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  /* Phones get the lighter version: markings only, no scratches. */
  .rink .scratches {
    display: none;
  }
  @media (min-width: 720px) {
    .rink .scratches {
      display: inline;
    }
  }
  .hero-inner {
    position: relative;
    max-width: 760px;
    margin: 0 auto;
  }
  .hero-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.8rem;
    margin: 0 0 1.25rem;
  }
  .season {
    font: 700 0.8rem/1 var(--display);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .matchup {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: start;
    gap: 0.5rem;
  }
  .side {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.35rem;
    min-width: 0;
  }
  .side :global(.logo) {
    box-shadow: 0 8px 30px -6px rgba(0, 0, 0, 0.7);
  }
  .code {
    font: 800 clamp(2.6rem, 14vw, 4.2rem) / 0.9 var(--display);
    letter-spacing: 0.02em;
    color: var(--text);
  }
  .side.us .code {
    color: var(--accent-text);
  }
  .full {
    font-size: 0.78rem;
    color: var(--muted);
    line-height: 1.25;
    max-width: 14ch;
  }
  .vs {
    align-self: center;
    margin-top: -1.6rem;
    font: 800 1.1rem/1 var(--display);
    letter-spacing: 0.12em;
    color: var(--dim);
  }
  .when {
    text-align: center;
    margin: 1.2rem 0 0.9rem;
    font-family: var(--display);
    font-size: 1.15rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .when strong {
    font-weight: 800;
  }
  .dot {
    color: var(--accent-text);
    margin: 0 0.4rem;
  }
  .where {
    display: block;
    font-family: var(--font);
    text-transform: none;
    letter-spacing: 0;
    font-size: 0.85rem;
    color: var(--muted);
    margin-top: 0.25rem;
  }
  .countdown {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
    max-width: 360px;
    margin: 0 auto;
  }
  .seg-digit {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.55rem 0 0.45rem;
    border-radius: 10px;
    background: var(--chip-bg);
    box-shadow:
      inset 0 1px 0 rgba(var(--fg-rgb), 0.06),
      inset 0 -2px 0 rgba(var(--accent-rgb), 0.6);
  }
  .seg-digit .v {
    font: 800 2rem/1 var(--display);
    color: var(--text);
  }
  .seg-digit .k {
    font: 700 0.68rem/1 var(--display);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--dim);
    margin-top: 0.3rem;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    margin-top: 1.2rem;
  }
  .hero-band {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 6px;
    background: var(--stripes-h);
  }
  @media (min-width: 720px) {
    .hero {
      padding: 2.6rem var(--gutter) 2.2rem;
    }
    .full {
      font-size: 0.95rem;
    }
  }
  @media (min-width: 1180px) {
    .hero {
      margin: 0 calc(50% - 50vw);
    }
  }

  /* ---------- Ticker ---------- */
  .ticker {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding: 0 var(--gutter);
    margin: 0 calc(-1 * var(--gutter));
    padding: 2px var(--gutter) 10px;
    scrollbar-width: none;
  }
  .ticker::-webkit-scrollbar {
    display: none;
  }
  /* Tablet/desktop: a fixed row that ends with the content — no overflow, no scrolling. */
  @media (min-width: 720px) {
    .ticker {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      overflow: visible;
      margin: 0;
      padding: 2px 0 0;
    }
    .ticker > :global(.bug) {
      min-width: 0;
    }
    .ticker > :global(.bug:nth-child(n + 5)) {
      display: none;
    }
  }
  @media (min-width: 1000px) {
    .ticker {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .ticker > :global(.bug:nth-child(n + 5)) {
      display: flex;
    }
    .ticker > :global(.bug:nth-child(n + 7)) {
      display: none;
    }
  }

  /* ---------- Duo blocks ---------- */
  .duo {
    display: grid;
    gap: 12px;
    margin-top: 12px;
  }
  @media (min-width: 900px) {
    .duo {
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      align-items: start;
    }
  }
  .last {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    color: var(--text);
    margin-top: 1rem;
  }
  .last:hover {
    color: var(--text);
    box-shadow: var(--glow-blue);
  }
  .last .eyebrow {
    align-self: flex-start;
  }
  .last-score {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0.2rem 0 0.4rem;
  }
