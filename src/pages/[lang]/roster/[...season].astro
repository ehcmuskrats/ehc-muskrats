---
import Base from '../../../layouts/Base.astro';
import SeasonPicker from '../../../components/SeasonPicker.astro';
import DataCredit from '../../../components/DataCredit.astro';
import Abbr from '../../../components/Abbr.astro';
import { type Lang, LANGS, useT, href, formatNumber } from '../../../i18n/index.ts';
import { ourSeasons, currentSeasonId, derived } from '../../../lib/data.ts';
import type { PlayerProfile, PlayerSeasonLine } from '../../../types/models.ts';

export function getStaticPaths() {
  return LANGS.flatMap((lang) => [
    { params: { lang, season: undefined } },
    ...ourSeasons.map((s) => ({ params: { lang, season: s.info.id } })),
  ]);
}
const lang = Astro.params.lang as Lang;
const seasonId = Astro.params.season ?? currentSeasonId;
const t = useT(lang);

// Player links carry the season when it isn't the current one, so the profile opens in that season.
const playerHref = (slug: string) =>
  href(lang, `players/${slug}/${seasonId !== currentSeasonId ? `?${lang === 'de' ? 'saison' : 'season'}=${seasonId}` : ''}`);

type Row = { p: PlayerProfile; l: PlayerSeasonLine };
const rows: Row[] = derived.players
  .map((p) => ({ p, l: p.seasons.find((s) => s.season === seasonId)! }))
  .filter((x) => x.l);
const FWD = /^(C|LF|RF|F)$/;
const DEF = /^(LD|RD|D)$/;
// Grouped by the position in the player's last game of the season.
const group = (r: Row) => {
  const pos = r.l.position;
  if (pos === 'G' || (r.l.goalieGp > 0 && r.l.goalieGp >= r.l.gp)) return 'goalies';
  if (pos && FWD.test(pos)) return 'forwards';
  if (pos && DEF.test(pos)) return 'defense';
  return 'other';
};
const byNumber = (a: Row, b: Row) => (a.l.number ?? 999) - (b.l.number ?? 999);
const groups = (['forwards', 'defense', 'goalies', 'other'] as const)
  .map((k) => ({ k, list: rows.filter((r) => group(r) === k).sort(byNumber) }))
  .filter((g) => g.list.length);
---

<Base lang={lang} title={`${t('roster.title')} ${seasonId.replace('-', '/')}`} path={Astro.params.season ? `roster/${seasonId}/` : 'roster/'} active="nav.roster" leagueData>
  <header class="page-head">
    <span class="tag">{t('common.season')} {seasonId.replace('-', '/')}</span>
    <h1>{t('roster.title')}</h1>
    <p class="sub">{rows.length} {lang === 'de' ? 'Spieler' : 'players'}</p>
  </header>
  <SeasonPicker lang={lang} section="roster" seasons={ourSeasons.map((x) => x.info.id)} current={seasonId} />

  {groups.length === 0 && <p class="muted">{t('roster.none')}</p>}

  {
    groups.map(({ k, list }) => (
      <section aria-labelledby={`h-${k}`}>
        <div class="sec-head">
          <h2 id={`h-${k}`}>{t(`roster.${k}`)}</h2>
          <span class="count tnum">{list.length}</span>
        </div>
        <ul class="rows roster">
          {list.map(({ p, l }) => (
            <li>
              <a href={playerHref(p.slug)}>
                <span class="jn tnum">{l.number ?? '–'}</span>
                <span class="nm">
                  <span class="fn">{p.first}</span>
                  <span class="ln">{p.last}</span>
                  <span class="pos">
                    {l.position ? t(`pos.${l.position}`) : ''}
                  </span>
                </span>
                {k === 'goalies' ? (
                  <span class="line tnum">
                    <span>
                      <b>{l.goalieGp}</b>
                      <Abbr lang={lang} k="gp" />
                    </span>
                    <span>
                      <b>{l.ga}</b>
                      <Abbr lang={lang} k="ga" />
                    </span>
                    <span class="hi">
                      <b>{formatNumber(lang, l.gaa, 2)}</b>
                      <Abbr lang={lang} k="gaa" />
                    </span>
                  </span>
                ) : (
                  <span class="line tnum">
                    <span>
                      <b>{l.gp}</b>
                      <Abbr lang={lang} k="gp" />
                    </span>
                    <span>
                      <b>{l.g}</b>
                      <Abbr lang={lang} k="g" />
                    </span>
                    <span>
                      <b>{l.a}</b>
                      <Abbr lang={lang} k="a" />
                    </span>
                    <span class="hi">
                      <b>{l.p}</b>
                      <Abbr lang={lang} k="p" />
                    </span>
                  </span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
  <DataCredit lang={lang} />
</Base>

<style>
  .count {
    font: 800 1.4rem/1 var(--display);
    color: var(--dim);
  }
  .roster a {
    display: grid;
    grid-template-columns: 3.2rem 1fr;
    grid-template-areas: 'jn nm' 'jn line';
    column-gap: 0.75rem;
    row-gap: 0.45rem;
    align-items: center;
    padding: 0.8rem 1rem 0.8rem 0.6rem;
    color: var(--text);
    position: relative;
    overflow: hidden;
  }
  .roster a:hover {
    background: rgba(255, 255, 255, 0.03);
    color: var(--text);
  }
  .jn {
    grid-area: jn;
    font: 800 2.6rem/1 var(--display);
    color: var(--text);
    text-align: center;
    align-self: center;
  }
  .nm {
    grid-area: nm;
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.1;
  }
  .fn {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .ln {
    font: 800 1.35rem/1.05 var(--display);
    padding-top: 0.12em; /* room for Ü/Ö/Ä */
    text-transform: uppercase;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pos {
    font-size: 0.75rem;
    color: var(--dim);
    margin-top: 0.15rem;
  }
  .line {
    grid-area: line;
    display: flex;
    gap: 1.1rem;
  }
  .line span {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
    font: 700 0.7rem/1 var(--display);
    letter-spacing: 0.1em;
    color: var(--dim);
  }
  .line b {
    font: 800 1.15rem/1 var(--display);
    color: #fff;
  }
  .line .hi b {
    color: var(--orange);
  }
  @media (min-width: 720px) {
    .roster a {
      grid-template-columns: 3.6rem 1fr auto;
      grid-template-areas: 'jn nm line';
      padding: 0.7rem 1.25rem 0.7rem 0.75rem;
    }
    .line b {
      font-size: 1.35rem;
    }
  }
</style>
