---
import Base from '../../../layouts/Base.astro';
import SeasonPicker from '../../../components/SeasonPicker.astro';
import DataCredit from '../../../components/DataCredit.astro';
import { type Lang, LANGS, useT, href, formatNumber } from '../../../i18n/index.ts';
import { ourSeasons, currentSeasonId, derived } from '../../../lib/data.ts';
import type { PlayerProfile, PlayerSeasonLine } from '../../../types/models.ts';

export function getStaticPaths() {
  return LANGS.flatMap((lang) => [
    { params: { lang, season: undefined } },
    ...ourSeasons.map((s) => ({ params: { lang, season: s.info.id } })),
  ]);
}
const lang = Astro.params.lang as Lang;
const seasonId = Astro.params.season ?? currentSeasonId;
const t = useT(lang);

type Row = { p: PlayerProfile; l: PlayerSeasonLine };
const rows: Row[] = derived.players
  .map((p) => ({ p, l: p.seasons.find((s) => s.season === seasonId)! }))
  .filter((x) => x.l);
const group = (r: Row) => {
  const pos = r.l.positions;
  if (pos.includes('G') && r.l.goalieGp >= r.l.gp) return 'goalies';
  if (pos.some((x) => /^(LD|RD|D)$/.test(x)) && !pos.some((x) => /^(C|LF|RF|F)$/.test(x))) return 'defense';
  if (pos.some((x) => /^(C|LF|RF|F)$/.test(x))) return 'forwards';
  if (pos.some((x) => /^(LD|RD|D)$/.test(x))) return 'defense';
  return 'other';
};
const byNumber = (a: Row, b: Row) => (a.l.numbers[0] ?? 999) - (b.l.numbers[0] ?? 999);
const groups = (['forwards', 'defense', 'goalies', 'other'] as const)
  .map((k) => ({ k, list: rows.filter((r) => group(r) === k).sort(byNumber) }))
  .filter((g) => g.list.length);
---

<Base lang={lang} title={`${t('roster.title')} ${seasonId.replace('-', '/')}`} path={Astro.params.season ? `roster/${seasonId}/` : 'roster/'} active="nav.roster" leagueData>
  <header class="page-head">
    <h1>{t('roster.title')}</h1>
    <p class="sub">{t('common.season')} {seasonId.replace('-', '/')}</p>
  </header>
  <SeasonPicker lang={lang} section="roster" seasons={ourSeasons.map((x) => x.info.id)} current={seasonId} />

  {groups.length === 0 && <p class="muted">{t('roster.none')}</p>}

  {
    groups.map(({ k, list }) => (
      <section aria-labelledby={`h-${k}`}>
        <h2 id={`h-${k}`}>{t(`roster.${k}`)}</h2>
        <ul class="roster">
          {list.map(({ p, l }) => (
            <li class="card">
              <a class="pl" href={href(lang, `players/${p.slug}/`)}>
                <span class="num" aria-label={t('col.no')}>
                  {l.numbers.length ? l.numbers.map((n) => `#${n}`).join(' ') : '–'}
                </span>
                <span class="name">
                  <span class="first">{p.first}</span> <strong>{p.last}</strong>
                </span>
                <span class="pos small muted">{l.positions.filter((x) => x !== 'G' || k === 'goalies').map((x) => t(`pos.${x}`)).join(', ')}</span>
              </a>
              {k === 'goalies' ? (
                <dl class="line small">
                  <div><dt>{t('col.gp')}</dt><dd>{l.goalieGp}</dd></div>
                  <div><dt>{t('col.ga')}</dt><dd>{l.ga}</dd></div>
                  <div><dt>{t('col.gaa')}</dt><dd>{formatNumber(lang, l.gaa, 2)}</dd></div>
                </dl>
              ) : (
                <dl class="line small">
                  <div><dt>{t('col.gp')}</dt><dd>{l.gp}</dd></div>
                  <div><dt>{t('col.g')}</dt><dd>{l.g}</dd></div>
                  <div><dt>{t('col.a')}</dt><dd>{l.a}</dd></div>
                  <div><dt>{t('col.p')}</dt><dd><strong>{l.p}</strong></dd></div>
                  <div><dt>{t('col.pim')}</dt><dd>{l.pim}</dd></div>
                </dl>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))
  }
  <DataCredit lang={lang} />
</Base>

<style>
  .roster {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  }
  .roster li {
    padding: 0.8rem 0.9rem;
    position: relative;
    overflow: hidden;
  }
  .roster li::after {
    content: '';
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 6px;
    background: var(--stripes);
    opacity: 0.8;
  }
  .pl {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 0.7rem;
    color: var(--text);
    text-decoration: none;
  }
  .pl:hover .name {
    text-decoration: underline;
  }
  .num {
    grid-row: span 2;
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--link);
    min-width: 2.6ch;
    line-height: 1.1;
  }
  .line {
    display: flex;
    gap: 0.9rem;
    margin: 0.5rem 0 0;
  }
  .line div {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .line dt {
    color: var(--muted);
    font-size: 0.75rem;
    text-transform: uppercase;
  }
  .line dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }
</style>
