---
import Base from '../../../layouts/Base.astro';
import Team from '../../../components/Team.astro';
import DataCredit from '../../../components/DataCredit.astro';
import Abbr from '../../../components/Abbr.astro';
import { type Lang, LANGS, useT, href, url, formatDate, formatNumber, mmss } from '../../../i18n/index.ts';
import { RESULT_FULL } from '../../../i18n/abbr.ts';
import { derived, playerExtras, columns, resultClass } from '../../../lib/data.ts';
import type { PlayerProfile } from '../../../types/models.ts';

export function getStaticPaths() {
  return LANGS.flatMap((lang) => derived.players.map((p) => ({ params: { lang, slug: p.slug }, props: { p } })));
}
const { p } = Astro.props as { p: PlayerProfile };
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const extra = playerExtras[String(p.id)];
const bio = extra?.bio?.[lang] ?? extra?.bio?.de;
const skaterSeasons = p.seasons.filter((s) => s.gp > 0);
const goalieSeasons = p.seasons.filter((s) => s.goalieGp > 0);
const showPm = p.seasons.some((s) => columns(s.season).plusMinus);
const c = p.career;
const situation = (s: string) => {
  const k = `situation.${s}`;
  const v = t(k);
  return v === k ? s : v;
};
// Current number and position (from the most recent game); full history stays in the data.
const numbers = p.currentNumber != null ? [p.currentNumber] : [];
const first = p.seasons.at(-1)?.season.replace('-', '/');
const lastS = p.seasons[0]?.season.replace('-', '/');
---

<Base lang={lang} title={`${p.first} ${p.last}`} path={`players/${p.slug}/`} active="nav.roster" leagueData>
  <section class="hero">
    <span class="bignum tnum" aria-hidden="true">{numbers[0] ?? ''}</span>
    <div class="hero-in">
      {extra?.photo && <img class="photo" src={url(extra.photo)} alt={`${p.first} ${p.last}`} width="120" height="120" />}
      <div>
        <span class="tag">
          {numbers.length ? `#${numbers[0]}` : '#–'}{p.currentPosition && ` · ${p.currentPosition}`}
        </span>
        <h1>
          <span class="fn">{p.first}</span>
          <span class="ln">{p.last}</span>
        </h1>
        <p class="sub">
          {p.currentPosition && t(`pos.${p.currentPosition}`)}
          {first && <> · {first === lastS ? first : `${first} – ${lastS}`}</>} · {p.seasons.length} {t('player.seasons')}
        </p>
      </div>
    </div>
    <div class="band" aria-hidden="true"></div>
  </section>

  {bio && <p class="bio">{bio}</p>}

  <section aria-label={t('player.career')}>
    <p class="eyebrow car">{t('player.career')}</p>
    {
      p.isGoalie ? (
        <div class="lockups">
          <div class="lockup">
            <span class="v">{c.goalieGp}</span>
            <span class="k"><Abbr lang={lang} k="gp" /></span>
          </div>
          <div class="lockup">
            <span class="v">{c.ga}</span>
            <span class="k"><Abbr lang={lang} k="ga" /></span>
          </div>
          <div class="lockup accent">
            <span class="v">{formatNumber(lang, c.gaa, 2)}</span>
            <span class="k"><Abbr lang={lang} k="gaa" /></span>
          </div>
          <div class="lockup">
            <span class="v">{c.toi ? Math.round(c.toi / 60) : '–'}</span>
            <span class="k">{lang === 'de' ? 'Minuten' : 'Minutes'}</span>
          </div>
        </div>
      ) : (
        <div class="lockups">
          <div class="lockup">
            <span class="v">{c.gp}</span>
            <span class="k"><Abbr lang={lang} k="gp" /></span>
          </div>
          <div class="lockup">
            <span class="v">{c.g}</span>
            <span class="k"><Abbr lang={lang} k="g" /></span>
          </div>
          <div class="lockup">
            <span class="v">{c.a}</span>
            <span class="k"><Abbr lang={lang} k="a" /></span>
          </div>
          <div class="lockup accent">
            <span class="v">{c.p}</span>
            <span class="k"><Abbr lang={lang} k="p" /></span>
          </div>
          <div class="lockup">
            <span class="v">{c.pim}</span>
            <span class="k"><Abbr lang={lang} k="pim" /></span>
          </div>
        </div>
      )
    }
  </section>

  {
    skaterSeasons.length > 0 && (
      <section aria-labelledby="h-seasons">
        <div class="sec-head">
          <h2 id="h-seasons">{t('player.bySeason')}</h2>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th class="sticky-col" scope="col">{t('common.season')}</th>
                <th class="num" scope="col"><Abbr lang={lang} k="no" /></th>
                <th class="num" scope="col"><Abbr lang={lang} k="gp" /></th>
                <th class="num" scope="col"><Abbr lang={lang} k="g" /></th>
                <th class="num" scope="col"><Abbr lang={lang} k="a" /></th>
                <th class="num" scope="col"><Abbr lang={lang} k="p" /></th>
                <th class="num" scope="col"><Abbr lang={lang} k="pim" /></th>
                <th class="num" scope="col"><Abbr lang={lang} k="ppg" /></th>
                <th class="num" scope="col"><Abbr lang={lang} k="shg" /></th>
                <th class="num" scope="col"><Abbr lang={lang} k="gwg" /></th>
                {showPm && <th class="num" scope="col"><Abbr lang={lang} k="pm" /></th>}
              </tr>
            </thead>
            <tbody>
              {skaterSeasons.map((s) => (
                <tr>
                  <td class="sticky-col">
                    <a href={href(lang, `stats/${s.season}/`)}>{s.season.replace('-', '/')}</a>
                  </td>
                  <td class="num dim">{s.number ?? '–'}</td>
                  <td class="num">{s.gp}</td>
                  <td class="num">{s.g}</td>
                  <td class="num">{s.a}</td>
                  <td class="num big">{s.p}</td>
                  <td class="num">{s.pim}</td>
                  <td class="num">{s.ppg}</td>
                  <td class="num">{s.shg}</td>
                  <td class="num">{s.gwg}</td>
                  {showPm && <td class="num">{columns(s.season).plusMinus ? s.plusMinus : '–'}</td>}
                </tr>
              ))}
              <tr class="ours total">
                <th class="sticky-col" scope="row">{t('player.career')}</th>
                <td />
                <td class="num">{c.gp}</td>
                <td class="num">{c.g}</td>
                <td class="num">{c.a}</td>
                <td class="num big">{c.p}</td>
                <td class="num">{c.pim}</td>
                <td class="num">{c.ppg}</td>
                <td class="num">{c.shg}</td>
                <td class="num">{c.gwg}</td>
                {showPm && <td />}
              </tr>
            </tbody>
          </table>
        </div>
      </section>
    )
  }

  {
    goalieSeasons.length > 0 && (
      <section aria-labelledby="h-gseasons">
        <div class="sec-head">
          <h2 id="h-gseasons">{t('roster.goalies')}</h2>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th class="sticky-col" scope="col">{t('common.season')}</th>
                <th class="num" scope="col"><Abbr lang={lang} k="gp" /></th>
                <th class="num" scope="col"><Abbr lang={lang} k="toi" /></th>
                <th class="num" scope="col"><Abbr lang={lang} k="ga" /></th>
                <th class="num" scope="col"><Abbr lang={lang} k="gaa" /></th>
              </tr>
            </thead>
            <tbody>
              {goalieSeasons.map((s) => (
                <tr>
                  <td class="sticky-col">{s.season.replace('-', '/')}</td>
                  <td class="num">{s.goalieGp}</td>
                  <td class="num">{s.toi ? mmss(s.toi) : '–'}</td>
                  <td class="num">{s.ga}</td>
                  <td class="num big">{formatNumber(lang, s.gaa, 2)}</td>
                </tr>
              ))}
              <tr class="ours total">
                <th class="sticky-col" scope="row">{t('player.career')}</th>
                <td class="num">{c.goalieGp}</td>
                <td class="num">{c.toi ? mmss(c.toi) : '–'}</td>
                <td class="num">{c.ga}</td>
                <td class="num big">{formatNumber(lang, c.gaa, 2)}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
    )
  }

  <section aria-labelledby="h-goals">
    <div class="sec-head">
      <h2 id="h-goals">{t('player.goals')}</h2>
      <span class="count tnum">{p.goals.length}</span>
    </div>
    {
      p.goals.length ? (
        <details class="more" open={p.goals.length <= 8}>
          <summary>{p.goals.length > 8 ? (lang === 'de' ? 'Alle Tore anzeigen' : 'Show all goals') : t('player.goals')}</summary>
          <ol class="rows goals">
            {p.goals.map((g) => (
              <li>
                <a href={href(lang, `games/${g.gameId}/`)}>
                  <span class="gd small dim">{formatDate(lang, g.date)}</span>
                  <Team team={g.opponent} short size={22} />
                  <span class="gt tnum">
                    {g.period === 'OT' || g.period === 'SO' ? g.period : `${g.period}.`} · {g.timeLabel}
                  </span>
                  <span class="gs">
                    <span class={`sit sit-${g.situation.slice(0, 2)}`}>{situation(g.situation)}</span>
                    {g.gwg && <span class="sit gwg">GWG</span>}
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </details>
      ) : (
        <p class="muted">{t('player.noGoals')}</p>
      )
    }
  </section>

  <section aria-labelledby="h-log">
    <div class="sec-head">
      <h2 id="h-log">{t('player.gameLog')}</h2>
      <span class="count tnum">{p.games.length}</span>
    </div>
    {
      p.games.length ? (
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th class="sticky-col" scope="col">{t('common.date')}</th>
                <th scope="col">{t('common.opponent')}</th>
                <th scope="col">{t('common.result')}</th>
                <th class="num" scope="col"><Abbr lang={lang} k="g" /></th>
                <th class="num" scope="col"><Abbr lang={lang} k="a" /></th>
                <th class="num" scope="col"><Abbr lang={lang} k="pim" /></th>
                {p.isGoalie && <th class="num" scope="col"><Abbr lang={lang} k="ga" /></th>}
              </tr>
            </thead>
            <tbody>
              {p.games.map((g) => (
                <tr>
                  <td class="sticky-col">
                    <a href={href(lang, `games/${g.gameId}/`)} class="tnum">
                      {formatDate(lang, g.date)}
                    </a>
                  </td>
                  <td>
                    <span class="dim small">{g.home ? 'vs' : '@'}</span> <Team team={g.opponent} short size={22} />
                  </td>
                  <td class="tnum">
                    {g.result && (
                      <span class={`res res-${resultClass(g.result)}`} title={RESULT_FULL[g.result][lang]}>
                        {g.result}
                      </span>
                    )}{' '}
                    {g.score}
                  </td>
                  <td class="num">{g.g || <span class="dim">0</span>}</td>
                  <td class="num">{g.a || <span class="dim">0</span>}</td>
                  <td class="num">{g.pim || <span class="dim">0</span>}</td>
                  {p.isGoalie && <td class="num">{g.goalie ? g.goalie.ga : '–'}</td>}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="muted">{t('player.noGames')}</p>
      )
    }
  </section>

  <DataCredit lang={lang} />
</Base>

<style>
  .hero {
    position: relative;
    margin: 0 calc(-1 * var(--gutter));
    padding: 2rem var(--gutter) 1.6rem;
    overflow: hidden;
    background:
      radial-gradient(90% 80% at 80% 10%, rgba(24, 112, 224, 0.45), transparent 70%),
      linear-gradient(160deg, #0d2a66, #081430 60%, var(--bg));
    min-height: 230px;
    display: flex;
    align-items: flex-end;
  }
  @media (min-width: 1180px) {
    .hero {
      margin: 0 calc(50% - 50vw);
      padding-left: calc(50vw - 50% + var(--gutter));
    }
  }
  .bignum {
    position: absolute;
    right: -0.05em;
    top: -0.12em;
    font: 800 clamp(11rem, 58vw, 20rem) / 1 var(--display);
    color: transparent;
    -webkit-text-stroke: 2px rgba(90, 162, 255, 0.28);
    letter-spacing: -0.02em;
    pointer-events: none;
  }
  .hero-in {
    position: relative;
    display: flex;
    align-items: flex-end;
    gap: 1rem;
    width: 100%;
    max-width: var(--maxw);
  }
  .photo {
    width: 104px;
    height: 104px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0 0 3px var(--orange);
  }
  h1 {
    margin: 0.6rem 0 0.35rem;
    line-height: 0.92;
  }
  h1 .fn {
    display: block;
    font-size: 0.45em;
    color: var(--muted);
    letter-spacing: 0.06em;
  }
  h1 .ln {
    display: block;
    font-size: clamp(2.8rem, 13vw, 4.6rem);
  }
  .sub {
    margin: 0;
    color: var(--muted);
    font-size: 0.88rem;
  }
  .band {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 5px;
    background: var(--stripes-h);
  }
  .bio {
    margin: 1.25rem 0 0;
    max-width: 62ch;
  }
  .car {
    margin-top: 1.4rem;
  }
  .count {
    font: 800 1.4rem/1 var(--display);
    color: var(--dim);
  }
  tr.total th {
    font-family: var(--display);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .more summary {
    cursor: pointer;
    font: 700 0.9rem/1 var(--display);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--link);
    padding: 0.4rem 0 0.8rem;
  }
  .more[open] summary {
    display: none;
  }
  .goals a {
    display: grid;
    grid-template-columns: 5.6rem auto 1fr;
    grid-template-areas: 'gd tm gt' 'gd tm gs';
    align-items: center;
    column-gap: 0.75rem;
    row-gap: 0.25rem;
    padding: 0.6rem 1rem;
    color: var(--text);
  }
  .goals a:hover {
    background: rgba(255, 255, 255, 0.03);
    color: var(--text);
  }
  .gd {
    grid-area: gd;
  }
  .goals a > :global(.team) {
    grid-area: tm;
  }
  .gt {
    grid-area: gt;
    font: 800 1rem/1 var(--display);
  }
  .gs {
    grid-area: gs;
    display: flex;
    gap: 4px;
  }
  .sit {
    font: 700 0.66rem/1 var(--display);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 3px 7px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.07);
    color: var(--muted);
  }
  .sit-PP {
    background: rgba(90, 162, 255, 0.16);
    color: var(--blue-hi);
  }
  .sit-SH {
    background: rgba(61, 220, 151, 0.14);
    color: var(--win);
  }
  .sit-EN,
  .sit-PS {
    background: rgba(232, 161, 116, 0.16);
    color: var(--brown);
  }
  .sit.gwg {
    background: var(--orange);
    color: var(--ink);
  }
</style>
