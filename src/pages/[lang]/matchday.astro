---
// Matchday info (#15): for anyone who has never been to a Muskrats game. Spectators are always welcome and
// entry is always free (confirmed by the team). Venue facts live in src/config/venues.ts.
import Base from '../../layouts/Base.astro';
import CalendarButton from '../../components/CalendarButton.astro';
import Team from '../../components/Team.astro';
import { type Lang, langPaths, useT, href, url, formatDate } from '../../i18n/index.ts';
import { ourGames, currentSeasonId, teamName, hasGamePage } from '../../lib/data.ts';
import { VENUES, venueFor, directionsUrl, hallOf } from '../../config/venues.ts';
import { isOurTeam } from '../../config/team.ts';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const de = lang === 'de';
const t = useT(lang);
const season = ourGames(currentSeasonId);
const next = season
  .filter((g) => g.status === 'scheduled' && g.timestamp != null && g.timestamp > Date.now() - 3 * 3600_000)
  .sort((a, b) => a.timestamp! - b.timestamp!)[0];
// Venues used this season first; fall back to all known venues.
const usedKeys = new Set(season.map((g) => venueFor(g.venue)?.key).filter(Boolean));
const venues = VENUES.filter((v) => usedKeys.has(v.key));
const show = venues.length ? venues : VENUES;
// Main hall first, then Halle 2, Halle 3 … (the Haupthalle is Halle 1).
const hallRank = (h: string) => (/haupt/i.test(h) ? 1 : Number(h.match(/\d+/)?.[0] ?? 99));
const halls = [...new Set(season.map((g) => hallOf(g.venue)).filter((h): h is string => !!h))].sort((a, b) => hallRank(a) - hallRank(b));
---

<Base lang={lang} title={de ? 'Spieltag-Infos' : 'Game Day info'} path="matchday/" active="nav.matchday">
  <header class="page-head">
    <span class="tag">{de ? 'Zuschauen' : 'Watch a game'}</span>
    <h1>{de ? 'Spieltag-Infos' : 'Game Day info'}</h1>
  </header>

  <section class="facts" aria-label={de ? 'Das Wichtigste' : 'The essentials'}>
    <div class="fact">
      <span class="fi" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M9 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7zM2.5 20c.6-3.6 3.3-5.5 6.5-5.5s5.9 1.9 6.5 5.5M16 4.3a3.5 3.5 0 0 1 0 6.4M18.5 14.8c1.7.8 2.8 2.6 3 5.2" /></svg>
      </span>
      <div>
        <p class="ft">{de ? 'Zuschauer willkommen' : 'Spectators welcome'}</p>
        <p class="fx">{de ? 'Bei jedem Spiel, egal gegen wen.' : 'At every game, whoever we play.'}</p>
      </div>
    </div>
    <div class="fact">
      <span class="fi" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M4 8.5h16v3a2 2 0 0 0 0 4v3H4v-3a2 2 0 0 0 0-4zM14.5 8.5v10" /></svg>
      </span>
      <div>
        <p class="ft">{de ? 'Eintritt frei' : 'Free entry'}</p>
        <p class="fx">{de ? 'Kein Ticket nötig. Einfach vorbeikommen.' : 'No ticket needed. Just turn up.'}</p>
      </div>
    </div>
  </section>

  {
    next && (
      <section aria-labelledby="h-next">
        <div class="sec-head">
          <h2 id="h-next">{t('home.nextGame')}</h2>
        </div>
        <a class="panel next" href={hasGamePage(next) ? href(lang, `games/${next.id}/`) : href(lang, 'schedule/')}>
          <Team team={isOurTeam(next.home) ? next.away : next.home} logoOnly size={40} />
          <span class="nx">
            <strong>
              {teamName(next.home)} – {teamName(next.away)}
            </strong>
            <span class="small dim">
              {formatDate(lang, next.date, { weekday: true })} · {next.time ?? t('common.tbd')} · {next.venue?.replace(/^Wien - /, '')}
            </span>
          </span>
          <span aria-hidden="true">→</span>
        </a>
        <div class="row-btns">
          <CalendarButton lang={lang} feed />
        </div>
      </section>
    )
  }

  {
    show.map((v) => {
      const dirs = directionsUrl(v.name);
      return (
        <section aria-labelledby={`h-${v.key}`}>
          <div class="sec-head">
            <h2 id={`h-${v.key}`}>{v.name}</h2>
          </div>
          <div class="panel venue">
            <p class="addr">{v.address}</p>
            {v.key === 'neuro-io-arena' && halls.length > 0 && (
              <p class="small dim">
                {de ? 'Diese Saison spielen wir in: ' : 'This season we play in: '}
                {halls.join(', ')}. {de ? 'Die Halle steht beim jeweiligen Spiel im Spielplan.' : 'The hall for each game is listed in the schedule.'}
              </p>
            )}
            {v.halls && v.halls.length > 0 && (
              <>
                <p class="eyebrow">{de ? 'Die drei Hallen' : 'The three halls'}</p>
                <ul class="halls">
                  {v.halls.map((h) => (
                    <li>
                      <span class="hb">{h.label}</span>
                      <span>{de ? h.de : h.en}</span>
                    </li>
                  ))}
                </ul>
                {v.hallPlan?.local && (
                  <figure class="plan-fig" id="hallenplan">
                    <a href={url(v.hallPlan.local.src)} target="_blank" rel="noopener" title={de ? 'Plan vergrößern' : 'Open full size'}>
                      <img
                        src={url(v.hallPlan.local.src)}
                        width={v.hallPlan.local.width}
                        height={v.hallPlan.local.height}
                        loading="lazy"
                        decoding="async"
                        alt={de
                          ? 'Hallenplan der neuro.io arena, Hallen und Eingänge rot markiert: Halle 1 (Haupthalle) mit Eingang an der Vorderseite; Halle 2 und Halle 3 links davon, mit gemeinsamem Seiteneingang „Halle 2 & 3“ beim Overtime; U1 Kagran rechts unten.'
                          : 'neuro.io arena site plan with the halls and entrances marked in red: Halle 1 (main hall) with its entrance at the front; Halle 2 and Halle 3 to the left with a shared side entrance "Halle 2 & 3" by the Overtime bar; U1 Kagran bottom right.'}
                      />
                    </a>
                    <figcaption class="small dim">
                      {de ? 'Original: ' : 'Original: '}
                      <a href={v.hallPlan.page} target="_blank" rel="noopener">neuro.io arena (neuroarena.at)</a>
                      {de ? ' · rote Markierungen: EHC Muskrats' : ' · red markings added by EHC Muskrats'}
                    </figcaption>
                  </figure>
                )}
                {v.hallPlan && !v.hallPlan.local && (
                  <a class="plan" href={v.hallPlan.page} target="_blank" rel="noopener">
                    {de ? 'Offizieller Hallenplan auf neuroarena.at' : 'Official hall plan on neuroarena.at'} ↗
                  </a>
                )}
              </>
            )}
            {v.notes && v.notes[lang].length > 0 && (
              <ul class="notes">
                {v.notes[lang].map((n) => (
                  <li>{n}</li>
                ))}
              </ul>
            )}
            {v.transit && (
              <>
                <p class="eyebrow">{de ? 'Öffentlich' : 'Public transport'}</p>
                <ul class="list">
                  {v.transit[lang].map((x) => (
                    <li>{x}</li>
                  ))}
                </ul>
              </>
            )}
            {v.parking && (
              <>
                <p class="eyebrow">{de ? 'Auto & Parken' : 'Car & parking'}</p>
                <ul class="list">
                  {v.parking[lang].map((x) => (
                    <li>{x}</li>
                  ))}
                </ul>
              </>
            )}
            <div class="row-btns">
              {dirs && (
                <a class="btn btn-ghost" href={dirs} target="_blank" rel="noopener">
                  {de ? 'Route planen' : 'Get directions'}
                </a>
              )}
              {v.website && (
                <a class="btn btn-ghost" href={v.website} target="_blank" rel="noopener">
                  {de ? 'Website der Halle' : 'Venue website'}
                </a>
              )}
            </div>
          </div>
        </section>
      );
    })
  }

  <p class="small dim src">
    {de ? 'Anreise-Infos laut Website der Halle; bitte vor der Fahrt kurz prüfen.' : "Travel info from the venue's website; please double-check before you go."}
  </p>
</Base>

<style>
  .facts {
    display: grid;
    gap: 10px;
    margin-top: 1rem;
  }
  @media (min-width: 720px) {
    .facts {
      grid-template-columns: 1fr 1fr;
    }
  }
  .fact {
    display: flex;
    gap: 0.9rem;
    align-items: center;
    padding: 1rem 1.1rem;
    border-radius: var(--radius);
    background: var(--panel);
    box-shadow: inset 0 0 0 1px rgba(var(--accent-rgb), 0.35);
  }
  .fi svg {
    width: 30px;
    height: 30px;
    fill: none;
    stroke: var(--accent-text);
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ft {
    margin: 0;
    font: 800 1.25rem/1.1 var(--display);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .fx {
    margin: 0.2rem 0 0;
    color: var(--muted);
    font-size: 0.92rem;
  }
  .next {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.8rem;
    color: var(--text);
  }
  .nx {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }
  .row-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 0.9rem;
  }
  .venue .addr {
    margin: 0 0 0.4rem;
    font-weight: 700;
    font-size: 1.05rem;
  }
  .venue .eyebrow {
    margin-top: 1rem;
  }
  .list,
  .notes {
    margin: 0.3rem 0 0;
    padding-left: 1.1rem;
    color: var(--muted);
    line-height: 1.6;
  }
  .halls {
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0;
  }
  .halls li {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
    padding: 0.55rem 0;
    border-top: 1px solid var(--line);
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--muted);
  }
  .halls li:first-child {
    border-top: 0;
  }
  .hb {
    flex: none;
    min-width: 6.2rem;
    font: 800 0.95rem/1.45 var(--display);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text);
  }
  .plan-fig {
    margin: 0.9rem 0 0.2rem;
  }
  .plan-fig img {
    display: block;
    width: 100%;
    max-width: 420px;
    height: auto;
    border-radius: 10px;
    box-shadow: 0 0 0 1px var(--line-strong);
    background: #fff;
  }
  .plan-fig figcaption {
    margin-top: 0.4rem;
  }
  .plan {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
  }
  .src {
    margin-top: 1.5rem;
  }
</style>
