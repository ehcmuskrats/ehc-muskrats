---
import Base from '../../layouts/Base.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import DataCredit from '../../components/DataCredit.astro';
import { type Lang, langPaths, useT, href, formatDate } from '../../i18n/index.ts';
import { highlights, games, ourGames } from '../../lib/data.ts';
import { TEAM } from '../../config/team.ts';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const summaries = new Map(ourGames().map((g) => [g.id, g]));
// Only show what we can place: game videos (matched/pinned) and non-game videos.
const visible = highlights.items.filter((h) => h.status !== 'ambiguous' && h.status !== 'unmatched');
const seasonOf = (h: (typeof visible)[number]) => h.season ?? 'other';
const bySeason = new Map<string, typeof visible>();
for (const h of visible) {
  const k = seasonOf(h);
  if (!bySeason.has(k)) bySeason.set(k, []);
  bySeason.get(k)!.push(h);
}
const seasonKeys = [...bySeason.keys()].sort((a, b) => (a === 'other' ? 1 : b === 'other' ? -1 : b.localeCompare(a)));
void games;
---

<Base lang={lang} title={t('highlights.title')} path="highlights/" active="nav.highlights">
  <header class="page-head">
    <h1>{t('highlights.title')}</h1>
    <p class="sub">
      {t('highlights.intro')} <a href={TEAM.youtube.channelUrl} rel="noopener">youtube.com/@hoooockeyyy</a>
    </p>
  </header>

  {visible.length === 0 && <p class="muted">{t('highlights.none')}</p>}

  {
    seasonKeys.map((k) => (
      <section aria-labelledby={`h-${k}`}>
        <h2 id={`h-${k}`}>{k === 'other' ? t('highlights.other') : `${t('common.season')} ${k.replace('-', '/')}`}</h2>
        <div class="grid grid-2">
          {bySeason.get(k)!.map((h) => {
            const g = h.gameId ? summaries.get(h.gameId) : undefined;
            return (
              <article class="card">
                <VideoEmbed lang={lang} video={h.video} />
                <p class="small meta">
                  {g ? (
                    <a href={href(lang, `games/${g.id}/`)}>
                      {t('highlights.toGame')}: {formatDate(lang, g.date)}
                      {g.homeScore != null && ` · ${g.homeScore}:${g.awayScore}`}
                    </a>
                  ) : (
                    <span class="muted">{formatDate(lang, h.video.publishedAt.slice(0, 10))}</span>
                  )}
                </p>
              </article>
            );
          })}
        </div>
      </section>
    ))
  }
  <DataCredit lang={lang} video />
</Base>

<style>
  .meta {
    margin: 0.5rem 0 0;
  }
  article.card {
    padding: 0.75rem;
  }
</style>
