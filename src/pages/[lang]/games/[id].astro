---
import Base from '../../../layouts/Base.astro';
import Team from '../../../components/Team.astro';
import VideoEmbed from '../../../components/VideoEmbed.astro';
import DataCredit from '../../../components/DataCredit.astro';
import PlayerName from '../../../components/PlayerName.astro';
import Abbr from '../../../components/Abbr.astro';
import { type Lang, LANGS, useT, href, formatDate, formatNumber, mmss } from '../../../i18n/index.ts';
import { RESULT_FULL, abbr, posCode } from '../../../i18n/abbr.ts';
import { ourGames, games, side, teamName, highlightFor, columns, resultCode, resultClass } from '../../../lib/data.ts';
import { recapForGame, newsSlug } from '../../../lib/news.ts';
import { penaltyLabel } from '../../../config/penalties.ts';
import { isOurTeam } from '../../../config/team.ts';
import type { Game, GameSummary, PersonName, Goal, Penalty } from '../../../types/models.ts';

export function getStaticPaths() {
  const list = ourGames().filter((g) => g.status === 'final' || g.status === 'live' || g.hasReport);
  return LANGS.flatMap((lang) => list.map((g) => ({ params: { lang, id: g.id }, props: { summary: g } })));
}
const { summary } = Astro.props as { summary: GameSummary };
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const game: Game | undefined = games.get(summary.id);
const g = game ?? summary;
const ourSide = side(g);
const cols = columns(g.season);
const video = highlightFor(g.id);
const recap = await recapForGame(lang, g.id);
const played = g.status === 'final' || g.status === 'live';
const r = resultCode(g);
const nPeriods = game?.numberOfPeriods ?? 3;
const periodName = (p: string) => {
  if (/^\d+$/.test(p)) return lang === 'de' ? `${p}. Drittel` : `${['1st', '2nd', '3rd'][Number(p) - 1] ?? p + 'th'} period`;
  return p === 'OT' ? 'Overtime' : p === 'SO' ? 'Shootout' : p;
};
const periodShort = (i: number) => (i < nPeriods ? String(i + 1) : i === nPeriods ? t('common.ot') : t('common.so'));
const name = (p: PersonName | null) => (p ? `${p.first} ${p.last}`.trim() : null);
const sideTeam = (s: 'home' | 'away') => (s === 'home' ? g.home : g.away);
const situation = (s: string) => {
  const k = `situation.${s}`;
  const v = t(k);
  return v === k ? s : v;
};
const byPeriod = <T extends { period: string }>(list: T[]) => {
  const m = new Map<string, T[]>();
  for (const x of list) {
    if (!m.has(x.period)) m.set(x.period, []);
    m.get(x.period)!.push(x);
  }
  return [...m.entries()];
};
const goalsBy = game ? byPeriod<Goal>(game.goals) : [];
const pensBy = game ? byPeriod<Penalty>(game.penalties) : [];
const title = `${teamName(g.home)} – ${teamName(g.away)}${played && g.homeScore != null ? ` ${g.homeScore}:${g.awayScore}` : ''}`;
const fmtDec = (n: number | null) => formatNumber(lang, n, 2);

// Team-stat comparison rows: [label, home value, away value, display home, display away]
const ts = game?.teamStats;
const compare: [string, number, number, string, string][] = ts
  ? [
      [t('game.pim'), ts.home.pim, ts.away.pim, String(ts.home.pim), String(ts.away.pim)],
      [t('game.powerplay'), ts.home.ppGoals, ts.away.ppGoals, `${ts.home.ppGoals}/${ts.home.ppChances}`, `${ts.away.ppGoals}/${ts.away.ppChances}`],
      [t('game.penaltyKilling'), ts.home.pkKilled, ts.away.pkKilled, `${ts.home.pkKilled}/${ts.home.pkSituations}`, `${ts.away.pkKilled}/${ts.away.pkSituations}`],
      [t('game.timeLeading'), ts.home.timeLeading, ts.away.timeLeading, mmss(ts.home.timeLeading), mmss(ts.away.timeLeading)],
      [t('game.timeTrailing'), ts.home.timeTrailing, ts.away.timeTrailing, mmss(ts.home.timeTrailing), mmss(ts.away.timeTrailing)],
      [t('game.timeOnPP'), ts.home.timeOnPP, ts.away.timeOnPP, mmss(ts.home.timeOnPP), mmss(ts.away.timeOnPP)],
      [t('game.timeSH'), ts.home.timeShorthanded, ts.away.timeShorthanded, mmss(ts.home.timeShorthanded), mmss(ts.away.timeShorthanded)],
      ...(cols.sog ? [[abbr(lang, 'sog').full, ts.home.sog, ts.away.sog, String(ts.home.sog), String(ts.away.sog)] as [string, number, number, string, string]] : []),
    ]
  : [];
const sections = game
  ? [
      ['goals', t('game.goals')],
      ['penalties', t('game.penalties')],
      ['lineups', t('game.lineups')],
      ['teamstats', t('game.teamStats')],
      ['info', t('game.officials')],
    ]
  : [];
---

<Base lang={lang} title={title} description={`${formatDate(lang, g.date)} · ${g.venue ?? ''}`} path={`games/${g.id}/`} active="nav.schedule" leagueData>
  <!-- SCORE BUG -->
  <section class="bug-hero" aria-label={t('game.title')}>
    <a class="back" href={href(lang, `schedule/${g.season}/`)}>← {t('nav.schedule')} {g.season.replace('-', '/')}</a>
    <p class="meta">
      <span class="tag">{g.playoff ? (g.playoff.encounter ?? g.playoff.roundLabel) : g.divisionName}</span>
      <span>{formatDate(lang, g.date, { weekday: true })}{g.time ? ` · ${g.time}` : ''}</span>
    </p>
    <div class="sb">
      {
        (['home', 'away'] as const).map((s) => {
          const team = sideTeam(s);
          const score = s === 'home' ? g.homeScore : g.awayScore;
          const other = s === 'home' ? g.awayScore : g.homeScore;
          const won = played && score != null && other != null && score > other;
          return (
            <div class={`tm ${s} ${isOurTeam(team) ? 'us' : ''} ${won ? 'won' : ''}`}>
              <Team team={team} logoOnly size={58} />
              <span class="code">{team.short || teamName(team).slice(0, 3)}</span>
              <span class="full">{teamName(team)}</span>
              <span class="score tnum">{played && score != null ? score : '–'}</span>
            </div>
          );
        })
      }
      <span class="status">
        {g.status === 'final' ? t('common.final') : g.status === 'live' ? t('common.live') : g.date ? '' : t('common.dateTbc')}
        {g.shootout ? ` · ${t('common.so')}` : g.overtime ? ` · ${t('common.ot')}` : ''}
      </span>
    </div>
    {
      g.periods.length > 0 && (
        <ol class="periods" aria-label={t('game.scoreByPeriod')}>
          {g.periods.map((p, i) => (
            <li>
              <span class="pn">{periodShort(i)}</span>
              <span class="ps tnum">
                {p[0]}:{p[1]}
              </span>
            </li>
          ))}
        </ol>
      )
    }
    <div class="sb-foot">
      {g.venue && <span>{g.venue.replace(/^Wien - /, '')}</span>}
      {r && <span class={`res res-${resultClass(r)}`} title={RESULT_FULL[r][lang]}>{r}</span>}
    </div>
    <div class="band" aria-hidden="true"></div>
  </section>

  {
    sections.length > 0 && (
      <nav class="jump seg" aria-label={t('game.title')}>
        {sections.map(([id, label]) => (
          <a href={`#${id}`}>{label}</a>
        ))}
      </nav>
    )
  }

  {
    recap && (
      <a class="btn btn-accent btn-block recap-btn" href={href(lang, `news/${newsSlug(recap)}/`)}>
        {t('game.recap')} →
      </a>
    )
  }

  {
    video && (
      <section aria-labelledby="h-hl">
        <div class="sec-head">
          <h2 id="h-hl">{t('common.highlights')}</h2>
        </div>
        <VideoEmbed lang={lang} video={video.video} />
      </section>
    )
  }

  {!played && <p class="muted info">{t('game.scheduledInfo')}</p>}
  {played && !game && <p class="missing info">{t('game.noReport')}</p>}

  {
    game && (
      <>
        <!-- GOALS: timeline -->
        <section id="goals" aria-labelledby="h-goals">
          <div class="sec-head">
            <h2 id="h-goals">{t('game.goals')}</h2>
          </div>
          {game.goals.length === 0 && <p class="muted">{t('game.noGoals')}</p>}
          {goalsBy.map(([period, list]) => (
            <div class="period-block">
              <p class="eyebrow">{periodName(period)}</p>
              <ol class="rows events">
                {list.map((goal) => (
                  <li class={goal.team === ourSide ? 'us' : 'them'}>
                    <span class="time tnum">{goal.timeLabel}</span>
                    <Team team={sideTeam(goal.team)} logoOnly size={24} />
                    <span class="who">
                      <span class="main">
                        <PlayerName lang={lang} p={goal.scorer} ours={goal.team === ourSide} />
                        {goal.scorer?.number != null && <span class="no tnum">#{goal.scorer.number}</span>}
                      </span>
                      <span class="sub">
                        {goal.assists.length ? (
                          goal.assists.map((a) => (
                            <span class="as">
                              <PlayerName lang={lang} p={a} ours={goal.team === ourSide} />
                            </span>
                          ))
                        ) : (
                          <span>{lang === 'de' ? 'ohne Assist' : 'unassisted'}</span>
                        )}
                      </span>
                      <span class="chips">
                        <span class={`sit sit-${goal.situation.slice(0, 2)}`}>{situation(goal.situation)}</span>
                        {goal.gwg && <span class="sit gwg">{t('game.gwg')}</span>}
                      </span>
                    </span>
                    <span class="run tnum">{goal.score}</span>
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </section>

        <!-- PENALTIES -->
        <section id="penalties" aria-labelledby="h-pen">
          <div class="sec-head">
            <h2 id="h-pen">{t('game.penalties')}</h2>
          </div>
          {game.penalties.length === 0 && <p class="muted">{t('game.noPenalties')}</p>}
          {pensBy.map(([period, list]) => (
            <div class="period-block">
              <p class="eyebrow">{periodName(period)}</p>
              <ol class="rows events">
                {list.map((p) => (
                  <li class={p.team === ourSide ? 'us' : 'them'}>
                    <span class="time tnum">{p.timeLabel}</span>
                    <Team team={sideTeam(p.team)} logoOnly size={24} />
                    <span class="who">
                      <span class="main">
                        {p.player ? <PlayerName lang={lang} p={p.player} ours={p.team === ourSide} /> : <span>{t('common.team')}</span>}
                      </span>
                      <span class="sub">
                        {penaltyLabel(p.code, lang)}
                        {p.servedBy && (
                          <>
                            {' · '}
                            {t('game.servedBy')} <PlayerName lang={lang} p={p.servedBy} ours={p.team === ourSide} />
                          </>
                        )}
                      </span>
                    </span>
                    <span class="mins tnum">
                      {p.minutes}
                      <small>MIN</small>
                    </span>
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </section>

        <!-- LINEUPS -->
        <section id="lineups" aria-labelledby="h-lineups" data-tabs>
          <div class="sec-head">
            <h2 id="h-lineups">{t('game.lineups')}</h2>
          </div>
          <div class="seg" role="tablist" aria-label={t('game.lineups')}>
            {(['home', 'away'] as const).map((s) => (
              <button type="button" role="tab" id={`tab-${s}`} aria-controls={`panel-${s}`} aria-selected={s === ourSide ? 'true' : 'false'}>
                {sideTeam(s).short || teamName(sideTeam(s))}
              </button>
            ))}
          </div>
          {(['home', 'away'] as const).map((s) => (
            <div class="lineup" role="tabpanel" id={`panel-${s}`} aria-labelledby={`tab-${s}`}>
              <p class="eyebrow lineup-team">{teamName(sideTeam(s))}</p>
              <div class="table-wrap">
                <table data-sortable class="lineup-table">
                  {/* Same fixed column widths for both teams, so headers don't move when switching tabs. */}
                  <colgroup>
                    <col class="c-no" />
                    <col />
                    <col class="c-pos" />
                    <col class="c-n" />
                    <col class="c-n" />
                    <col class="c-n" />
                    {cols.plusMinus && <col class="c-n" />}
                    <col class="c-n" />
                    {cols.sog && <col class="c-n" />}
                  </colgroup>
                  <thead>
                    <tr>
                      <th class="num" scope="col" data-sort="num"><button type="button"><Abbr lang={lang} k="no" /></button></th>
                      <th class="sticky-col" scope="col" data-sort="text"><button type="button">{t('common.player')}</button></th>
                      <th scope="col" data-sort="text"><button type="button"><Abbr lang={lang} k="pos" /></button></th>
                      <th class="num" scope="col" data-sort="num"><button type="button"><Abbr lang={lang} k="g" /></button></th>
                      <th class="num" scope="col" data-sort="num"><button type="button"><Abbr lang={lang} k="a" /></button></th>
                      <th class="num" scope="col" data-sort="num"><button type="button"><Abbr lang={lang} k="p" /></button></th>
                      {cols.plusMinus && <th class="num" scope="col" data-sort="num"><button type="button"><Abbr lang={lang} k="pm" /></button></th>}
                      <th class="num" scope="col" data-sort="num"><button type="button"><Abbr lang={lang} k="pim" /></button></th>
                      {cols.sog && <th class="num" scope="col" data-sort="num"><button type="button"><Abbr lang={lang} k="sog" /></button></th>}
                    </tr>
                  </thead>
                  <tbody>
                    {[...game.skaters[s]]
                      .sort((a, b) => (a.player.number ?? 999) - (b.player.number ?? 999))
                      .map((sk) => (
                        <tr>
                          <td class="num dim">{sk.player.number ?? '–'}</td>
                          <td class="sticky-col">
                            <PlayerName lang={lang} p={sk.player} ours={isOurTeam(sideTeam(s))} />
                          </td>
                          <td>
                            <abbr title={t(`pos.${sk.position}`)}>{posCode(sk.position)}</abbr>
                          </td>
                          <td class="num">{sk.g}</td>
                          <td class="num">{sk.a}</td>
                          <td class="num strong">{sk.p}</td>
                          {cols.plusMinus && <td class="num">{sk.plusMinus}</td>}
                          <td class="num">{sk.pim}</td>
                          {cols.sog && <td class="num">{sk.sog}</td>}
                        </tr>
                      ))}
                  </tbody>
                </table>
              </div>

              <p class="eyebrow goalie-head">{t('game.goalies')}</p>
              <ul class="rows goalies">
                {game.goalies[s].map((gl) => (
                  <li>
                    <span class="no tnum">#{gl.player.number ?? '–'}</span>
                    <span class="gname">
                      <PlayerName lang={lang} p={gl.player} ours={isOurTeam(sideTeam(s))} />
                    </span>
                    {gl.toi > 0 ? (
                      <span class="gstats tnum">
                        <span>
                          <b>{mmss(gl.toi)}</b>
                          <Abbr lang={lang} k="toi" />
                        </span>
                        <span>
                          <b>{gl.goalsAgainst}</b>
                          <Abbr lang={lang} k="ga" />
                        </span>
                        <span>
                          <b>{fmtDec(gl.gaa)}</b>
                          <Abbr lang={lang} k="gaa" />
                        </span>
                        {cols.saves && (
                          <span>
                            <b>{gl.saves}</b>
                            <Abbr lang={lang} k="sv" />
                          </span>
                        )}
                      </span>
                    ) : (
                      <span class="dim small">{lang === 'de' ? 'nicht eingesetzt' : 'did not play'}</span>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))}
          {game.goalieChanges.some((c) => c.time > 0) && (
            <details class="changes">
              <summary>{t('game.goalieChanges')}</summary>
              <ul>
                {game.goalieChanges.map((c) => (
                  <li class="tnum">
                    {c.timeLabel} · {sideTeam(c.team).short} · <PlayerName lang={lang} p={c.player} ours={c.team === ourSide} /> ·{' '}
                    {c.action === 'on' ? t('game.on') : t('game.off')}
                  </li>
                ))}
              </ul>
            </details>
          )}
        </section>

        <!-- TEAM STATS: head-to-head bars -->
        <section id="teamstats" aria-labelledby="h-ts">
          <div class="sec-head">
            <h2 id="h-ts">{t('game.teamStats')}</h2>
          </div>
          <div class="panel h2h">
            <div class="h2h-head">
              <Team team={g.home} short />
              <Team team={g.away} short />
            </div>
            {compare.map(([label, hv, av, hd, ad]) => {
              const total = hv + av || 1;
              return (
                <div class="h2h-row">
                  <span class="hv tnum">{hd}</span>
                  <span class="lbl">{label}</span>
                  <span class="av tnum">{ad}</span>
                  <span class="bar" aria-hidden="true">
                    <i class={`h ${ourSide === 'home' ? 'us' : ''}`} style={`width:${(hv / total) * 100}%`} />
                    <i class={`a ${ourSide === 'away' ? 'us' : ''}`} style={`width:${(av / total) * 100}%`} />
                  </span>
                </div>
              );
            })}
          </div>
        </section>

        <!-- INFO -->
        <section id="info" aria-labelledby="h-off">
          <div class="sec-head">
            <h2 id="h-off">{t('game.officials')}</h2>
          </div>
          <dl class="facts panel">
            <div>
              <dt>{t('game.referees')}</dt>
              <dd>{game.referees.length ? game.referees.map(name).join(', ') : <span class="missing">{t('common.missing')}</span>}</dd>
            </div>
            {game.linesmen.length > 0 && (
              <div>
                <dt>{t('game.linesmen')}</dt>
                <dd>{game.linesmen.map(name).join(', ')}</dd>
              </div>
            )}
            {(game.headCoaches.home || game.headCoaches.away) && (
              <div>
                <dt>{t('game.headCoach')}</dt>
                <dd>
                  {g.home.short}: {name(game.headCoaches.home) ?? '–'} · {g.away.short}: {name(game.headCoaches.away) ?? '–'}
                </dd>
              </div>
            )}
            {game.startTime && (
              <div>
                <dt>{t('game.started')}</dt>
                <dd>{game.startTime}</dd>
              </div>
            )}
            {game.periodLength > 0 && (
              <div>
                <dt>{t('game.periodLength')}</dt>
                <dd>
                  {game.numberOfPeriods} × {Math.round(game.periodLength / 60)} min
                </dd>
              </div>
            )}
            {g.venue && (
              <div>
                <dt>{t('common.venue')}</dt>
                <dd>{g.venue}</dd>
              </div>
            )}
          </dl>
        </section>
      </>
    )
  }

  <DataCredit lang={lang} video={!!video} />
</Base>

<style>
  /* ---------- Score bug hero ---------- */
  .bug-hero {
    position: relative;
    margin: 0 calc(-1 * var(--gutter));
    padding: 0.9rem var(--gutter) 1.2rem;
    background:
      radial-gradient(90% 70% at 50% 0%, rgba(var(--fg-rgb), 0.06), transparent 70%),
      linear-gradient(170deg, var(--hero-a), var(--hero-b) 60%, var(--bg));
    overflow: hidden;
  }
  .bug-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(-62deg, rgba(var(--fg-rgb), 0.03) 0 2px, transparent 2px 22px);
    pointer-events: none;
  }
  .back {
    position: relative;
    display: inline-block;
    font: 700 0.85rem/1 var(--display);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    padding: 0.4rem 0;
  }
  .meta {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem 0.75rem;
    margin: 0.6rem 0 1rem;
    font: 700 0.9rem/1 var(--display);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .sb {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 0.75rem;
    max-width: 560px;
    margin: 0 auto;
  }
  .tm {
    display: grid;
    grid-template-areas: 'logo score' 'code score' 'full full';
    grid-template-columns: auto 1fr;
    align-items: center;
    column-gap: 0.6rem;
    row-gap: 0.15rem;
  }
  .tm.away {
    grid-template-areas: 'score logo' 'score code' 'full full';
    grid-template-columns: 1fr auto;
    text-align: right;
  }
  .tm :global(.team) {
    grid-area: logo;
  }
  .tm.away :global(.team) {
    justify-self: end;
  }
  .code {
    grid-area: code;
    font: 800 1.7rem/1 var(--display);
    color: var(--muted);
  }
  .tm.us .code {
    color: var(--accent-text);
  }
  .full {
    grid-area: full;
    font-size: 0.75rem;
    color: var(--dim);
    line-height: 1.25;
  }
  .score {
    grid-area: score;
    font: 800 clamp(4.2rem, 22vw, 6.5rem) / 0.85 var(--display);
    color: var(--muted);
    text-align: center;
  }
  .tm.won .score {
    color: var(--text);
    text-shadow: 0 0 40px rgba(var(--fg-rgb), 0.22);
  }
  .status {
    grid-column: 1 / -1;
    text-align: center;
    margin-top: 0.7rem;
    font: 800 0.85rem/1 var(--display);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .periods {
    position: relative;
    list-style: none;
    display: flex;
    justify-content: center;
    gap: 6px;
    padding: 0;
    margin: 0.8rem 0 0;
  }
  .periods li {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.4rem 0.7rem;
    border-radius: 8px;
    background: rgba(0, 0, 0, 0.3);
    box-shadow: inset 0 1px 0 rgba(var(--fg-rgb), 0.05);
  }
  .pn {
    font: 700 0.72rem/1 var(--display);
    letter-spacing: 0.1em;
    color: var(--dim);
  }
  .ps {
    font: 800 1.05rem/1 var(--display);
  }
  .sb-foot {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.8rem;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .band {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 5px;
    background: var(--stripes-h);
  }
  @media (min-width: 1180px) {
    .bug-hero {
      margin: 0 calc(50% - 50vw);
    }
  }
  @media (min-width: 720px) {
    .bug-hero {
      padding-bottom: 1.6rem;
    }
