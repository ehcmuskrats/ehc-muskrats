---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Team from '../../../components/Team.astro';
import { type Lang, LANGS, useT, href, formatDate } from '../../../i18n/index.ts';
import { newsFor, newsSlug, type NewsEntry } from '../../../lib/news.ts';
import { games } from '../../../lib/data.ts';

export async function getStaticPaths() {
  const out = [];
  for (const lang of LANGS) {
    for (const post of await newsFor(lang)) out.push({ params: { lang, slug: newsSlug(post) }, props: { post } });
  }
  return out;
}
const { post } = Astro.props as { post: NewsEntry };
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const { Content } = await render(post);
const game = post.data.gameId ? games.get(post.data.gameId) : undefined;
// Language switch: the translation if one exists, else the other language's news list.
const other = lang === 'de' ? 'en' : 'de';
const translation = post.data.translationKey
  ? (await newsFor(other)).find((p) => p.data.translationKey === post.data.translationKey)
  : undefined;
const switchPath = translation ? `news/${newsSlug(translation)}/` : 'news/';
---

<Base lang={lang} title={post.data.title} description={post.data.summary} path={switchPath} active="nav.news" leagueData={!!game}>
  <article>
    <header class="page-head">
      <a class="back" href={href(lang, 'news/')}>← {t('news.title')}</a>
      <p class="eyebrow">{formatDate(lang, post.data.date.toISOString())}{post.data.author && ` · ${post.data.author}`}</p>
      <h1>{post.data.title}</h1>
      {post.data.summary && <p class="sub lead">{post.data.summary}</p>}
    </header>
    {
      post.data.gameId && (
        <a class="panel game-link" href={href(lang, `games/${post.data.gameId}/`)}>
          {game ? (
            <>
              <Team team={game.home} short />
              <span class="sc tnum">
                {game.homeScore ?? '–'}:{game.awayScore ?? '–'}
              </span>
              <Team team={game.away} short />
              <span class="dim small d">{formatDate(lang, game.date)} →</span>
            </>
          ) : (
            <span>{t('news.toGame')} →</span>
          )}
        </a>
      )
    }
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .back {
    display: inline-block;
    font: 700 0.85rem/1 var(--display);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1rem;
  }
  .lead {
    font-size: 1.1rem;
    max-width: 60ch;
  }
  .game-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 1rem 0 1.5rem;
    color: var(--text);
  }
  .game-link:hover {
    color: var(--text);
    box-shadow: var(--glow-blue);
  }
  .sc {
    font: 800 1.6rem/1 var(--display);
  }
  .d {
    margin-left: auto;
  }
</style>
