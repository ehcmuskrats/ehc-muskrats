---
import Base from '../../../layouts/Base.astro';
import { type Lang, langPaths, useT, href, formatDate } from '../../../i18n/index.ts';
import { newsFor, newsSlug } from '../../../lib/news.ts';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const posts = await newsFor(lang);
---

<Base lang={lang} title={t('news.title')} path="news/" active="nav.news">
  <header class="page-head">
    <h1>{t('news.title')}</h1>
  </header>
  {posts.length === 0 && <p class="muted">{t('news.none')}</p>}
  <div class="grid">
    {
      posts.map((p) => (
        <article class="card">
          <p class="small muted">{formatDate(lang, p.data.date.toISOString())}</p>
          <h2>
            <a href={href(lang, `news/${newsSlug(p)}/`)}>{p.data.title}</a>
          </h2>
          {p.data.summary && <p>{p.data.summary}</p>}
          <p class="small">
            <a href={href(lang, `news/${newsSlug(p)}/`)}>{t('news.readMore')} →</a>
            {p.data.gameId && (
              <>
                {' · '}
                <a href={href(lang, `games/${p.data.gameId}/`)}>{t('news.toGame')}</a>
              </>
            )}
          </p>
        </article>
      ))
    }
  </div>
</Base>
