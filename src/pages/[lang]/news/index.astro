---
import Base from '../../../layouts/Base.astro';
import { type Lang, langPaths, useT, href, formatDate } from '../../../i18n/index.ts';
import { newsFor, newsSlug } from '../../../lib/news.ts';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const posts = await newsFor(lang);
---

<Base lang={lang} title={t('news.title')} path="news/" active="nav.news">
  <header class="page-head">
    <h1>{t('news.title')}</h1>
  </header>
  {posts.length === 0 && <p class="muted empty">{t('news.none')}</p>}
  <ol class="rows posts">
    {
      posts.map((p) => (
        <li>
          <a href={href(lang, `news/${newsSlug(p)}/`)}>
            <span class="eyebrow">
              {formatDate(lang, p.data.date.toISOString())}
              {p.data.gameId && <span class="tag ghost">{lang === 'de' ? 'Spielbericht' : 'Recap'}</span>}
            </span>
            <span class="pt">{p.data.title}</span>
            {p.data.summary && <span class="ps">{p.data.summary}</span>}
          </a>
        </li>
      ))
    }
  </ol>
</Base>

<style>
  .posts:empty {
    display: none;
  }
  .posts a {
    display: block;
    padding: 1rem 1.1rem;
    color: var(--text);
  }
  .posts a:hover {
    background: rgba(255, 255, 255, 0.03);
    color: var(--text);
  }
  .posts .eyebrow {
    margin-bottom: 0.4rem;
  }
  .pt {
    display: block;
    font: 800 1.45rem/1.05 var(--display);
    text-transform: uppercase;
  }
  .ps {
    display: block;
    margin-top: 0.35rem;
    color: var(--muted);
  }
</style>
