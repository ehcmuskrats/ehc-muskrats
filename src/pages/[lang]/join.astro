---
import Base from '../../layouts/Base.astro';
import { type Lang, langPaths, useT, url } from '../../i18n/index.ts';
import { SITE } from '../../config/site.ts';
import { TEAM } from '../../config/team.ts';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const email = SITE.contactEmail.trim();
const fee = SITE.membership.feeEur.toLocaleString(lang === 'de' ? 'de-AT' : 'en-GB');
const facts = [
  ['join.level', t('join.levelText')],
  ['join.rink', `${SITE.homeRink}, ${SITE.homeRinkAddress}`],
  ['join.practice', t('join.practiceText')],
  ['join.cost', t('join.costText', { fee, season: SITE.membership.season })],
] as const;
---

<Base lang={lang} title={t('join.title')} path="join/" active="nav.join">
  <section class="hero">
    <img class="logo" src={url('logo.png')} width="140" height="140" alt="" />
    <span class="tag">{TEAM.leagueName}</span>
    <h1>{t('join.title')}</h1>
    <p class="lead">{t('join.intro')}</p>
    <div class="cta">
      <a class="btn btn-accent btn-block" href={TEAM.facebookUrl} rel="noopener">
        <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"
          ><path
            fill="currentColor"
            d="M24 12.07C24 5.41 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.04V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.5c-1.5 0-1.96.93-1.96 1.89v2.26h3.32l-.53 3.5h-2.8V24C19.62 23.1 24 18.1 24 12.07"
          ></path></svg
        >
        {t('join.facebook')}
      </a>
      {
        email && (
          <a class="btn btn-ghost btn-block" href={`mailto:${email}`}>
            {email}
          </a>
        )
      }
    </div>
    <div class="band" aria-hidden="true"></div>
  </section>

  <ul class="rows facts">
    {
      facts.map(([key, text]) => (
        <li>
          <p class="eyebrow">{t(key)}</p>
          <p class="txt">{text}</p>
        </li>
      ))
    }
  </ul>

  <section class="contact panel">
    <h2>{t('join.contact')}</h2>
    <p class="muted">{t('join.contactText')}</p>
    <a class="btn btn-brand btn-block" href={TEAM.facebookUrl} rel="noopener">{t('join.facebook')} →</a>
    {
      email && (
        <p class="mail">
          {t('join.email')}: <a href={`mailto:${email}`}>{email}</a>
        </p>
      )
    }
  </section>
</Base>

<style>
  .hero {
    position: relative;
    margin: 0 calc(-1 * var(--gutter));
    padding: 2rem var(--gutter) 2rem;
    text-align: center;
    overflow: hidden;
    background:
      radial-gradient(80% 70% at 50% 0%, rgba(247, 122, 26, 0.22), transparent 70%),
      linear-gradient(170deg, #0d2a66, #081430 60%, var(--bg));
  }
  @media (min-width: 1180px) {
    .hero {
      margin: 0 calc(50% - 50vw);
    }
  }
  .logo {
    width: 120px;
    height: 120px;
    display: block;
    margin: 0 auto 1rem;
    filter: drop-shadow(0 10px 30px rgba(24, 112, 224, 0.6));
  }
  h1 {
    margin: 0.7rem 0 0.5rem;
  }
  .lead {
    max-width: 44ch;
    margin: 0 auto 1.4rem;
    color: var(--muted);
    font-size: 1.05rem;
  }
  .cta {
    display: grid;
    gap: 10px;
    max-width: 380px;
    margin: 0 auto;
  }
  .band {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 5px;
    background: var(--stripes-h);
  }
  .fee {
    margin-top: 1.25rem;
    text-align: center;
  }
  .fee .eyebrow {
    justify-content: center;
  }
  .amount {
    font: 800 4rem/1 var(--display);
    color: var(--orange);
    margin: 0.2rem 0 0.3rem;
    text-shadow: 0 0 40px rgba(247, 122, 26, 0.35);
  }
  .fee .muted {
    margin: 0;
  }
  .facts {
    margin-top: 1.25rem;
  }
  .facts li {
    padding: 1rem 1.1rem;
  }
  .facts .eyebrow {
    margin-bottom: 0.35rem;
  }
  .txt {
    margin: 0;
    font-size: 1.02rem;
  }
  .contact {
    margin-top: 1.25rem;
  }
  .contact h2 {
    margin-bottom: 0.3rem;
  }
  .mail {
    margin: 0.8rem 0 0;
    text-align: center;
  }
  @media (min-width: 720px) {
    .contact .btn {
      width: auto;
    }
  }
</style>
