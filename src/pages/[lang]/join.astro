---
import Base from '../../layouts/Base.astro';
import { type Lang, langPaths, useT, url } from '../../i18n/index.ts';
import { SITE } from '../../config/site.ts';
import { TEAM } from '../../config/team.ts';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const email = SITE.contactEmail.trim();
const fee = SITE.membership.feeEur.toLocaleString(lang === 'de' ? 'de-AT' : 'en-GB');
---

<Base lang={lang} title={t('join.title')} path="join/" active="nav.join">
  <header class="page-head join-head">
    <img src={url('logo.png')} width="120" height="120" alt="" />
    <div>
      <h1>{t('join.title')}</h1>
      <p class="sub">{t('join.intro')}</p>
    </div>
  </header>

  <div class="grid grid-2">
    <section class="card">
      <h2 class="card-title">{t('join.level')}</h2>
      <p>{t('join.levelText')}</p>
    </section>
    <section class="card">
      <h2 class="card-title">{t('join.rink')}</h2>
      <p>
        <strong>{SITE.homeRink}</strong>, Wien<br />
        <span class="muted">{SITE.homeRinkAddress}</span>
      </p>
    </section>
    <section class="card">
      <h2 class="card-title">{t('join.practice')}</h2>
      <p>{t('join.practiceText')}</p>
    </section>
    <section class="card">
      <h2 class="card-title">{t('join.cost')}</h2>
      <p class="fee">{t('join.costText', { fee, season: SITE.membership.season })}</p>
    </section>
  </div>

  <section class="card contact">
    <h2>{t('join.contact')}</h2>
    <p>{t('join.contactText')}</p>
    <div class="buttons">
      <a class="btn btn-brand btn-lg" href={TEAM.facebookUrl} rel="noopener">
        <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"
          ><path
            fill="currentColor"
            d="M24 12.07C24 5.41 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.04V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.5c-1.5 0-1.96.93-1.96 1.89v2.26h3.32l-.53 3.5h-2.8V24C19.62 23.1 24 18.1 24 12.07"
          ></path></svg
        >
        {t('join.facebook')}
      </a>
      {
        email && (
          <a class="btn btn-ghost btn-lg" href={`mailto:${email}`}>
            {t('join.email')}: {email}
          </a>
        )
      }
    </div>
  </section>
</Base>

<style>
  .join-head {
    display: flex;
    gap: 1rem;
    align-items: center;
  }
  .join-head img {
    width: clamp(80px, 20vw, 120px);
    height: auto;
  }
  .fee {
    font-size: 1.15rem;
    font-weight: 700;
  }
  .contact {
    margin-top: var(--gutter);
    border-top: 6px solid var(--orange);
  }
  .buttons {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
</style>
