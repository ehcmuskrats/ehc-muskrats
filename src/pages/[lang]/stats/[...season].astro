---
import Base from '../../../layouts/Base.astro';
import Team from '../../../components/Team.astro';
import SeasonPicker from '../../../components/SeasonPicker.astro';
import DataCredit from '../../../components/DataCredit.astro';
import Abbr from '../../../components/Abbr.astro';
import { type Lang, LANGS, useT, href, formatNumber, formatDate, mmss } from '../../../i18n/index.ts';
import { abbr, posCode } from '../../../i18n/abbr.ts';
import { ourSeasons, currentSeasonId, derived, season as getSeason, columns } from '../../../lib/data.ts';
import { TEAM, isOurTeam } from '../../../config/team.ts';
import type { LeaderPenalty, TeamSeasonStats } from '../../../types/models.ts';

type Phase = 'all' | 'regular' | 'playoffs';
const hasPlayoffs = (sid: string) => derived.players.some((p) => p.playoffs.seasons.some((l) => l.season === sid));

export function getStaticPaths() {
  // (getStaticPaths runs in isolation, so it can't use helpers defined elsewhere in this file.)
  const hasPlayoffs = (sid: string) => derived.players.some((p) => p.playoffs.seasons.some((l) => l.season === sid));
  return LANGS.flatMap((lang) => [
    { params: { lang, season: undefined } },
    { params: { lang, season: 'all-time' } },
    ...ourSeasons.map((s) => ({ params: { lang, season: s.info.id } })),
    // Phase views (regular season / playoffs only) for seasons with playoff games.
    ...ourSeasons
      .filter((s) => hasPlayoffs(s.info.id))
      .flatMap((s) => [
        { params: { lang, season: `${s.info.id}/regular` } },
        { params: { lang, season: `${s.info.id}/playoffs` } },
      ]),
  ]);
}
const lang = Astro.params.lang as Lang;
const allTime = Astro.params.season === 'all-time';
const [seasonParam, phaseParam] = (Astro.params.season ?? '').split('/');
const seasonId = allTime || !seasonParam ? currentSeasonId : seasonParam;
const phase: Phase = phaseParam === 'regular' || phaseParam === 'playoffs' ? phaseParam : 'all';
const t = useT(lang);
const cols = columns(seasonId);
const s = getSeason(seasonId);
const seasonHasPlayoffs = hasPlayoffs(seasonId);
// Which league divisions belong to the chosen phase (for the penalty and team tables).
const divInPhase = (divisionId: number) => {
  if (phase === 'all') return true;
  const isPo = s?.info.divisions.find((d) => d.id === divisionId)?.kind === 'playoffs';
  return phase === 'playoffs' ? isPo : !isPo;
};
const phaseLabel = { all: lang === 'de' ? 'Gesamt' : 'Total', regular: 'Grunddurchgang', playoffs: t('common.playoffs') };
if (lang === 'en') phaseLabel.regular = 'Regular season';

// ----- Season view -----
const lines = derived.players
  .map((p) => {
    const src = phase === 'all' ? p.seasons : phase === 'regular' ? p.regular.seasons : p.playoffs.seasons;
    return { p, l: src.find((x) => x.season === seasonId)! };
  })
  .filter((x) => x.l);
const skaters = lines.filter((x) => x.l.gp > 0).sort((a, b) => b.l.p - a.l.p || b.l.g - a.l.g);
const goalies = lines.filter((x) => x.l.goalieGp > 0).sort((a, b) => b.l.goalieGp - a.l.goalieGp);
const penMap = new Map<number, LeaderPenalty>();
for (const st of (s?.stats ?? []).filter((x) => divInPhase(x.divisionId))) {
  for (const r of st.penalties.filter((x) => x.teamId === TEAM.leagueTeamId)) {
    const e = penMap.get(r.player.id);
    if (!e) penMap.set(r.player.id, { ...r });
    else {
      e.gp += r.gp;
      e.pim += r.pim;
      e.minors += r.minors;
      e.majors += r.majors;
      e.misconducts += r.misconducts + r.gameMisconducts + r.matchPenalties;
    }
  }
}
const penalties = [...penMap.values()].filter((r) => r.pim > 0).sort((a, b) => b.pim - a.pim);
const slugOf = (id: number) => derived.players.find((p) => p.id === id)?.slug;
const teamTables: { name: string; rows: TeamSeasonStats[] }[] = (s?.stats ?? [])
  .filter((st) => divInPhase(st.divisionId) && st.teams.some((r) => isOurTeam(r.team)))
  .map((st) => ({ name: s!.info.divisions.find((d) => d.id === st.divisionId)?.name ?? '', rows: st.teams }));
const pct = (n: number | null) => (n == null ? '–' : `${formatNumber(lang, n, 1)}%`);
const leader = skaters[0];

// ----- All-time view -----
const career = derived.players.filter((p) => p.career.gp > 0 || p.career.goalieGp > 0);
const top = (key: 'p' | 'gp' | 'g' | 'pim') =>
  [...career]
    .filter((p) => p.career[key] > 0)
    .sort((a, b) => b.career[key] - a.career[key] || b.career.g - a.career.g)
    .slice(0, 10);
const topPlayoffs = derived.players
  .filter((p) => p.playoffs.career.p > 0)
  .sort((a, b) => b.playoffs.career.p - a.playoffs.career.p || b.playoffs.career.g - a.playoffs.career.g)
  .slice(0, 10);
const rec = derived.records;
const at = rec.allTime;
const boards = [
  ['stats.careerPoints', 'p'],
  ['stats.careerGoals', 'g'],
  ['stats.careerGames', 'gp'],
  ['stats.careerPim', 'pim'],
] as const;
const tabs = [
  ['scorers', t('stats.scorers')],
  ['goalies', t('stats.goalies')],
  ['penalties', t('stats.penalties')],
  ['teams', t('stats.teamStats')],
] as const;
---

<Base
  lang={lang}
  title={allTime ? t('stats.allTime') : `${t('stats.title')} ${seasonId.replace('-', '/')}`}
  path={Astro.params.season ? `stats/${Astro.params.season}/` : 'stats/'}
  active="nav.stats"
  leagueData
>
  <header class="page-head">
    <span class="tag">
      {allTime ? t('stats.allTime') : `${t('common.season')} ${seasonId.replace('-', '/')}${phase !== 'all' ? ` · ${phaseLabel[phase]}` : ''}`}
    </span>
    <h1>{t('stats.title')}</h1>
  </header>

  <div class="controls">
    <nav class="seg view-switch" aria-label={t('stats.title')}>
      <a href={href(lang, 'stats/')} aria-current={!allTime ? 'page' : undefined}>{t('stats.seasonView')}</a>
      <a href={href(lang, 'stats/all-time/')} aria-current={allTime ? 'page' : undefined}>{t('stats.allTime')}</a>
    </nav>
    {!allTime && <SeasonPicker lang={lang} section="stats" seasons={ourSeasons.map((x) => x.info.id)} current={seasonId} />}
    {
      !allTime && seasonHasPlayoffs && (
        <nav class="seg phase-seg" aria-label={lang === 'de' ? 'Phase' : 'Phase'}>
          {(['all', 'regular', 'playoffs'] as const).map((ph) => (
            <a
              href={href(lang, ph === 'all' ? `stats/${seasonId}/` : `stats/${seasonId}/${ph}/`)}
              aria-current={phase === ph ? 'page' : undefined}
            >
              {phaseLabel[ph]}
            </a>
          ))}
        </nav>
      )
    }
  </div>

  {
    !allTime && (
      <>
        {leader && (
          <div class="lockups season-lockups">
            <div class="lockup accent">
              <span class="v">{leader.l.p}</span>
              <span class="k">
                <Abbr lang={lang} k="p" /> · {leader.p.last}
              </span>
            </div>
            <div class="lockup">
              <span class="v">{skaters.reduce((n, x) => n + x.l.g, 0)}</span>
              <span class="k">{lang === 'de' ? 'Tore Team' : 'Team goals'}</span>
            </div>
            <div class="lockup">
              <span class="v">{skaters.length}</span>
              <span class="k">{lang === 'de' ? 'Spieler' : 'Players'}</span>
            </div>
          </div>
        )}

        <div data-tabs class="tabs">
          <div class="seg tabbar-seg" role="tablist" aria-label={t('stats.title')}>
            {tabs.map(([id, label], i) => (
              <button type="button" role="tab" id={`tab-${id}`} aria-controls={`panel-${id}`} aria-selected={i === 0 ? 'true' : 'false'}>
                {label}
              </button>
            ))}
          </div>

          <section role="tabpanel" id="panel-scorers" aria-labelledby="tab-scorers">
            {skaters.length ? (
              <div class="table-wrap">
                <table data-sortable>
                  <thead>
                    <tr>
                      <th class="num" scope="col" data-sort="num"><button type="button"><Abbr lang={lang} k="no" /></button></th>
                      <th class="sticky-col" scope="col" data-sort="text"><button type="button">{t('common.player')}</button></th>
                      <th class="num" scope="col" data-sort="num"><button type="button"><Abbr lang={lang} k="gp" /></button></th>
                      <th class="num" scope="col" data-sort="num"><button type="button"><Abbr lang={lang} k="g" /></button></th>
                      <th class="num" scope="col" data-sort="num"><button type="button"><Abbr lang={lang} k="a" /></button></th>
                      <th class="num" scope="col" data-sort="num" aria-sort="descending"><button type="button"><Abbr lang={lang} k="p" /></button></th>
                      <th class="num" scope="col" data-sort="num"><button type="button"><Abbr lang={lang} k="pim" /></button></th>
                      <th class="num" scope="col" data-sort="num"><button type="button"><Abbr lang={lang} k="ppg" /></button></th>
                      <th class="num" scope="col" data-sort="num"><button type="button"><Abbr lang={lang} k="shg" /></button></th>
                      <th class="num" scope="col" data-sort="num"><button type="button"><Abbr lang={lang} k="gwg" /></button></th>
                      {cols.plusMinus && <th class="num" scope="col" data-sort="num"><button type="button"><Abbr lang={lang} k="pm" /></button></th>}
                      {cols.sog && <th class="num" scope="col" data-sort="num"><button type="button"><Abbr lang={lang} k="sog" /></button></th>}
                      <th scope="col" data-sort="text"><button type="button"><Abbr lang={lang} k="pos" /></button></th>
                    </tr>
                  </thead>
                  <tbody>
                    {skaters.map(({ p, l }) => (
                      <tr>
                        <td class="num dim">{l.number ?? '–'}</td>
                        <td class="sticky-col">
                          <a href={href(lang, `players/${p.slug}/`)}>
                            {p.first.charAt(0)}. {p.last}
                          </a>
                        </td>
                        <td class="num">{l.gp}</td>
                        <td class="num">{l.g}</td>
                        <td class="num">{l.a}</td>
                        <td class="num big">{l.p}</td>
                        <td class="num">{l.pim}</td>
                        <td class="num">{l.ppg}</td>
                        <td class="num">{l.shg}</td>
                        <td class="num">{l.gwg}</td>
                        {cols.plusMinus && <td class="num">{l.plusMinus}</td>}
                        {cols.sog && <td class="num">{l.sog}</td>}
                        <td class="dim">{posCode(l.position)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ) : (
              <p class="missing">{t('common.missing')}</p>
            )}
          </section>

          <section role="tabpanel" id="panel-goalies" aria-labelledby="tab-goalies" hidden>
            {goalies.length ? (
              <div class="table-wrap">
                <table data-sortable>
                  <thead>
                    <tr>
                      <th class="num" scope="col" data-sort="num"><button type="button"><Abbr lang={lang} k="no" /></button></th>
                      <th class="sticky-col" scope="col" data-sort="text"><button type="button">{t('common.player')}</button></th>
                      <th class="num" scope="col" data-sort="num" aria-sort="descending"><button type="button"><Abbr lang={lang} k="gp" /></button></th>
                      <th class="num" scope="col" data-sort="num"><button type="button"><Abbr lang={lang} k="ga" /></button></th>
                      <th class="num" scope="col" data-sort="num"><button type="button"><Abbr lang={lang} k="gaa" /></button></th>
                      <th class="num" scope="col" data-sort="num"><button type="button"><Abbr lang={lang} k="toi" /></button></th>
                      {cols.saves && <th class="num" scope="col" data-sort="num"><button type="button"><Abbr lang={lang} k="sa" /></button></th>}
                      {cols.saves && <th class="num" scope="col" data-sort="num"><button type="button"><Abbr lang={lang} k="sv" /></button></th>}
                    </tr>
                  </thead>
                  <tbody>
                    {goalies.map(({ p, l }) => (
                      <tr>
                        <td class="num dim">{l.number ?? '–'}</td>
                        <td class="sticky-col">
                          <a href={href(lang, `players/${p.slug}/`)}>
                            {p.first.charAt(0)}. {p.last}
                          </a>
                        </td>
                        <td class="num">{l.goalieGp}</td>
                        <td class="num">{l.ga}</td>
                        <td class="num big" data-v={l.gaa ?? ''}>{formatNumber(lang, l.gaa, 2)}</td>
                        <td class="num" data-v={l.toi}>{l.toi ? mmss(l.toi) : '–'}</td>
                        {cols.saves && <td class="num">{l.shotsAgainst}</td>}
                        {cols.saves && <td class="num">{l.saves}</td>}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ) : (
              <p class="missing">{t('common.missing')}</p>
            )}
          </section>

          <section role="tabpanel" id="panel-penalties" aria-labelledby="tab-penalties" hidden>
            {penalties.length ? (
              <div class="table-wrap">
                <table data-sortable>
                  <thead>
                    <tr>
                      <th class="sticky-col" scope="col" data-sort="text"><button type="button">{t('common.player')}</button></th>
                      <th class="num" scope="col" data-sort="num"><button type="button"><Abbr lang={lang} k="gp" /></button></th>
                      <th class="num" scope="col" data-sort="num" aria-sort="descending"><button type="button"><Abbr lang={lang} k="pim" /></button></th>
                      <th class="num" scope="col" data-sort="num"><button type="button"><Abbr lang={lang} k="minors" /></button></th>
                      <th class="num" scope="col" data-sort="num"><button type="button"><Abbr lang={lang} k="majors" /></button></th>
                      <th class="num" scope="col" data-sort="num"><button type="button"><Abbr lang={lang} k="misc" /></button></th>
                    </tr>
                  </thead>
                  <tbody>
                    {penalties.map((r) => (
                      <tr>
                        <td class="sticky-col">
                          {slugOf(r.player.id) ? (
                            <a href={href(lang, `players/${slugOf(r.player.id)}/`)}>
                              {r.player.first.charAt(0)}. {r.player.last}
                            </a>
                          ) : (
                            `${r.player.first.charAt(0)}. ${r.player.last}`
                          )}
                        </td>
                        <td class="num">{r.gp}</td>
                        <td class="num big">{r.pim}</td>
                        <td class="num">{r.minors}</td>
                        <td class="num">{r.majors}</td>
                        <td class="num">{r.misconducts + r.gameMisconducts + r.matchPenalties}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ) : (
              <p class="missing">{t('common.missing')}</p>
            )}
          </section>

          <section role="tabpanel" id="panel-teams" aria-labelledby="tab-teams" hidden>
            {teamTables.length === 0 && <p class="missing">{t('common.missing')}</p>}
            {teamTables.map((tt) => (
              <div class="team-table">
                <p class="eyebrow">{tt.name}</p>
                <div class="table-wrap">
                  <table data-sortable>
                    <thead>
                      <tr>
                        <th class="sticky-col" scope="col" data-sort="text"><button type="button">{t('common.team')}</button></th>
                        <th class="num" scope="col" data-sort="num"><button type="button"><Abbr lang={lang} k="gp" /></button></th>
                        <th class="num" scope="col" data-sort="num"><button type="button"><Abbr lang={lang} k="pppct" /></button></th>
                        <th class="num" scope="col" data-sort="num"><button type="button"><Abbr lang={lang} k="pp" /></button></th>
                        <th class="num" scope="col" data-sort="num"><button type="button"><Abbr lang={lang} k="pkpct" /></button></th>
                        <th class="num" scope="col" data-sort="num"><button type="button"><Abbr lang={lang} k="pk" /></button></th>
                        <th class="num" scope="col" data-sort="num"><button type="button"><Abbr lang={lang} k="pim" /></button></th>
                      </tr>
                    </thead>
                    <tbody>
                      {tt.rows.map((r) => (
                        <tr class={isOurTeam(r.team) ? 'ours' : undefined}>
                          <td class="sticky-col">
                            <Team team={r.team} short />
                          </td>
                          <td class="num">{r.gp}</td>
                          <td class="num big" data-v={r.ppPct ?? ''}>{pct(r.ppPct)}</td>
                          <td class="num" data-v={r.ppGoals}>
                            {r.ppGoals}/{r.ppChances}
                          </td>
                          <td class="num big" data-v={r.pkPct ?? ''}>{pct(r.pkPct)}</td>
                          <td class="num" data-v={r.pkSituations - r.ppGoalsAgainst}>
                            {r.pkSituations - r.ppGoalsAgainst}/{r.pkSituations}
                          </td>
                          <td class="num">{r.pim}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            ))}
          </section>
        </div>

        <p class="small dim note">
          {t('stats.source')} {!cols.sog && !cols.plusMinus && t('stats.hiddenCols')} {t('common.sortHint')}.
        </p>
      </>
    )
  }

  {
    allTime && (
      <>
        <section aria-labelledby="h-rec">
          <div class="sec-head">
            <h2 id="h-rec">{t('stats.allTimeRecord')}</h2>
          </div>
          <div class="lockups">
            <div class="lockup">
              <span class="v">{at.gp}</span>
              <span class="k">
                <Abbr lang={lang} k="gp" />
              </span>
            </div>
            <div class="lockup accent">
              <span class="v">{at.w + at.otw}</span>
              <span class="k">
                <Abbr lang={lang} k="w" />
              </span>
            </div>
            <div class="lockup">
              <span class="v">{at.l + at.otl}</span>
              <span class="k">
                <Abbr lang={lang} k="l" />
              </span>
            </div>
            {at.ties > 0 && (
              <div class="lockup">
                <span class="v">{at.ties}</span>
                <span class="k">
                  <Abbr lang={lang} k="t" />
                </span>
              </div>
            )}
            <div class="lockup">
              <span class="v">{at.gf}</span>
              <span class="k">
                <Abbr lang={lang} k="gf" />
              </span>
            </div>
            <div class="lockup">
              <span class="v">{at.ga}</span>
              <span class="k">
                <Abbr lang={lang} k="ga" />
              </span>
            </div>
          </div>
        </section>

        <section aria-labelledby="h-records">
          <div class="sec-head">
            <h2 id="h-records">{t('stats.teamRecords')}</h2>
          </div>
          <div class="grid grid-3">
            {rec.biggestWin && (
              <a class="panel record" href={href(lang, `games/${rec.biggestWin.gameId}/`)}>
                <p class="eyebrow">{t('stats.biggestWin')}</p>
                <span class="rv tnum">{rec.biggestWin.score}</span>
                <span class="rd">
                  vs <Team team={rec.biggestWin.opponent} />
                </span>
                <span class="small dim">{formatDate(lang, rec.biggestWin.date)}</span>
              </a>
            )}
            {rec.mostGoals && (
              <a class="panel record" href={href(lang, `games/${rec.mostGoals.gameId}/`)}>
                <p class="eyebrow">{t('stats.mostGoals')}</p>
                <span class="rv tnum">{rec.mostGoals.goalsFor}</span>
                <span class="rd">
                  {rec.mostGoals.score} vs <Team team={rec.mostGoals.opponent} />
                </span>
                <span class="small dim">{formatDate(lang, rec.mostGoals.date)}</span>
              </a>
            )}
            {rec.bestSeason && (
              <a class="panel record" href={href(lang, `standings/${rec.bestSeason.season}/`)}>
                <p class="eyebrow">{t('stats.bestSeason')}</p>
                <span class="rv tnum">{rec.bestSeason.season.replace('-', '/')}</span>
                <span class="rd tnum">
                  {rec.bestSeason.pts} {abbr(lang, 'pts').short} / {rec.bestSeason.gp} {abbr(lang, 'gp').short} · #{rec.bestSeason.rank}
                </span>
                <span class="small dim">{rec.bestSeason.divisionName}</span>
              </a>
            )}
          </div>
        </section>

        <div class="boards">
          {boards.map(([label, key]) => {
            const list = top(key);
            return (
              <section>
                <div class="sec-head">
                  <h2>{t(label)}</h2>
                </div>
                <ol class="rows leaders">
                  {list.map((p, i) => (
                    <li>
                      <a href={href(lang, `players/${p.slug}/`)} class={i === 0 ? 'first' : undefined}>
                        <span class="rk tnum">{i + 1}</span>
                        <span class="nm">
                          <span class="fn">{p.first}</span>
                          <span class="ln">{p.last}</span>
                        </span>
                        <span class="sn small dim">
                          {p.seasons.length} {t('player.seasons')}
                        </span>
                        <span class="pt tnum">
                          {p.career[key]}
                          <small>{abbr(lang, key).short}</small>
                        </span>
                      </a>
                    </li>
                  ))}
                </ol>
              </section>
            );
          })}
          {topPlayoffs.length > 0 && (
            <section>
              <div class="sec-head">
                <h2>{t('stats.careerPlayoffPoints')}</h2>
              </div>
              <ol class="rows leaders">
                {topPlayoffs.map((p, i) => (
                  <li>
                    <a href={href(lang, `players/${p.slug}/`)} class={i === 0 ? 'first' : undefined}>
                      <span class="rk tnum">{i + 1}</span>
                      <span class="nm">
                        <span class="fn">{p.first}</span>
                        <span class="ln">{p.last}</span>
                      </span>
                      <span class="sn small dim tnum">
                        {p.playoffs.career.gp} {abbr(lang, 'gp').short} · {p.playoffs.career.g} {abbr(lang, 'g').short} · {p.playoffs.career.a}{' '}
                        {abbr(lang, 'a').short}
                      </span>
                      <span class="pt tnum">
                        {p.playoffs.career.p}
                        <small>{abbr(lang, 'p').short}</small>
                      </span>
                    </a>
                  </li>
                ))}
              </ol>
            </section>
          )}
        </div>
      </>
    )
  }
  <DataCredit lang={lang} />
</Base>

<style>
  .controls {
    align-items: center;
  }
  .controls :global(.season-picker) {
    margin: 0;
  }
  .view-switch {
    flex: 0 1 auto;
  }
  .phase-seg {
    flex-basis: 100%;
  }
  .phase-seg [aria-current='page'] {
    background: var(--orange);
    color: var(--ink);
    box-shadow: var(--glow-orange);
  }
  .season-lockups {
    margin-bottom: 1rem;
  }
  .tabs .tabbar-seg {
    margin-bottom: 0.9rem;
  }
  .team-table + .team-table {
    margin-top: 1.2rem;
  }
  .note {
    margin-top: 1rem;
  }
  .record {
