---
import Base from '../../../layouts/Base.astro';
import Team from '../../../components/Team.astro';
import SeasonPicker from '../../../components/SeasonPicker.astro';
import DataCredit from '../../../components/DataCredit.astro';
import Abbr from '../../../components/Abbr.astro';
import { type Lang, LANGS, useT, href } from '../../../i18n/index.ts';
import { ourSeasons, currentSeasonId, season as getSeason, ourGames, games as reports } from '../../../lib/data.ts';
import { isOurTeam } from '../../../config/team.ts';

export function getStaticPaths() {
  return LANGS.flatMap((lang) => [
    { params: { lang, season: undefined } },
    ...ourSeasons.map((s) => ({ params: { lang, season: s.info.id } })),
  ]);
}
const lang = Astro.params.lang as Lang;
const seasonId = Astro.params.season ?? currentSeasonId;
const t = useT(lang);
const s = getSeason(seasonId);
// The latest phase we played in first (e.g. "TOP 4"), then other phases newest first.
const hasUs = (st: { rows: { team: Parameters<typeof isOurTeam>[0] }[] }) => st.rows.some((r) => isOurTeam(r.team));
const tables = s ? [...s.standings].sort((a, b) => Number(hasUs(b)) - Number(hasUs(a)) || b.divisionId - a.divisionId) : [];
const anyTies = tables.some((st) => st.rows.some((r) => r.ties > 0));
const anyOt = tables.some((st) => st.rows.some((r) => r.otw > 0 || r.otl > 0));
const bracket = s?.playoffs;
const gameById = new Map((s?.games ?? []).map((g) => [g.id, g]));
const ourIds = new Set(ourGames(seasonId).map((g) => g.id));
void reports;
---

<Base lang={lang} title={`${t('standings.title')} ${seasonId.replace('-', '/')}`} path={Astro.params.season ? `standings/${seasonId}/` : 'standings/'} active="nav.standings" leagueData>
  <header class="page-head">
    <span class="tag">{t('common.season')} {seasonId.replace('-', '/')}</span>
    <h1>{t('standings.title')}</h1>
  </header>
  <SeasonPicker lang={lang} section="standings" seasons={ourSeasons.map((x) => x.info.id)} current={seasonId} />

  {tables.length === 0 && <p class="muted">{t('standings.none')}</p>}

  {
    tables.map((st) => (
      <section aria-labelledby={`h-${st.divisionId}`}>
        <div class="sec-head">
          <h2 id={`h-${st.divisionId}`}>{st.divisionName}</h2>
          {st.unofficial && <span class="tag ghost">{t('standings.unofficial')}</span>}
        </div>
        <div class="table-wrap">
          <table class="standings">
            <thead>
              <tr>
                <th class="num" scope="col">
                  <Abbr lang={lang} k="rank" />
                </th>
                <th class="sticky-col" scope="col">
                  {t('common.team')}
                </th>
                <th class="num" scope="col">
                  <Abbr lang={lang} k="gp" />
                </th>
                <th class="num" scope="col">
                  <Abbr lang={lang} k="w" />
                </th>
                {anyOt && (
                  <th class="num" scope="col">
                    <Abbr lang={lang} k="otw" />
                  </th>
                )}
                {anyOt && (
                  <th class="num" scope="col">
                    <Abbr lang={lang} k="otl" />
                  </th>
                )}
                {anyTies && (
                  <th class="num" scope="col">
                    <Abbr lang={lang} k="t" />
                  </th>
                )}
                <th class="num" scope="col">
                  <Abbr lang={lang} k="l" />
                </th>
                <th class="num" scope="col">
                  <Abbr lang={lang} k="gf" />
                </th>
                <th class="num" scope="col">
                  <Abbr lang={lang} k="ga" />
                </th>
                <th class="num" scope="col">
                  <Abbr lang={lang} k="gd" />
                </th>
                <th class="num" scope="col">
                  <Abbr lang={lang} k="pts" />
                </th>
              </tr>
            </thead>
            <tbody>
              {st.rows.map((r) => (
                <tr class={isOurTeam(r.team) ? 'ours' : undefined}>
                  <td class="num rank">{r.rank}</td>
                  <td class="sticky-col team-col">
                    <Team team={r.team} responsive />
                  </td>
                  <td class="num">{r.gp}</td>
                  <td class="num">{r.w}</td>
                  {anyOt && <td class="num">{r.otw}</td>}
                  {anyOt && <td class="num">{r.otl}</td>}
                  {anyTies && <td class="num">{r.ties}</td>}
                  <td class="num">{r.l}</td>
                  <td class="num">{r.gf}</td>
                  <td class="num">{r.ga}</td>
                  <td class="num">{r.gd > 0 ? `+${r.gd}` : r.gd}</td>
                  <td class="num big">{r.pts}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ))
  }

  {
    bracket && bracket.phases.length > 0 && (
      <section aria-labelledby="h-bracket">
        <div class="sec-head">
          <h2 id="h-bracket">{t('standings.bracket')}</h2>
        </div>
        <div class="bracket">
          {bracket.phases.map((ph) => (
            <div class="round">
              <p class="eyebrow">{ph.label}</p>
              {ph.encounters.map((enc) => {
                const mine = enc.teams.some((x) => isOurTeam(x.team));
                const encGames = enc.gameIds.map((id) => gameById.get(id)).filter((g) => g && g.status === 'final');
                return (
                  <div class={`enc ${mine ? 'mine' : ''}`}>
                    <ul>
                      {enc.teams.map((x) => (
                        <li class={`${x.winner ? 'winner' : ''} ${isOurTeam(x.team) ? 'us' : ''}`}>
                          <Team team={x.team} />
                          <span class="wins tnum">{enc.bestOf > 1 ? x.wins : x.winner ? '✓' : ''}</span>
                        </li>
                      ))}
                    </ul>
                    {encGames.length > 0 && (
                      <p class="games-line">
                        {encGames.map((g, i) =>
                          ourIds.has(g!.id) ? (
                            <a href={href(lang, `games/${g!.id}/`)} class="tnum">
                              {t('common.game')} {i + 1}: {g!.homeScore}:{g!.awayScore}
                            </a>
                          ) : (
                            <span class="tnum">
                              {t('common.game')} {i + 1}: {g!.homeScore}:{g!.awayScore}
                            </span>
                          ),
                        )}
                      </p>
                    )}
                  </div>
                );
              })}
            </div>
          ))}
        </div>
      </section>
    )
  }

  <DataCredit lang={lang} />
</Base>

<style>
  .rank {
    color: var(--dim);
    width: 2rem;
  }
  .team-col {
    width: 100%;
  }
  @media (min-width: 600px) {
    .team-col {
      min-width: 14rem;
    }
  }
  .bracket {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 900px) {
    .bracket {
      grid-auto-flow: column;
      grid-auto-columns: 1fr;
      gap: 1rem;
      align-items: center;
    }
  }
  .round {
    display: grid;
    gap: 8px;
  }
  .round .eyebrow {
    margin-bottom: 0.1rem;
  }
  .enc {
    background: var(--panel);
    border-radius: 12px;
    box-shadow: var(--highlight);
    padding: 0.55rem 0.8rem;
    position: relative;
  }
  .enc.mine {
    box-shadow:
      var(--highlight),
      inset 3px 0 0 var(--orange);
  }
  .enc ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .enc li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    min-height: 34px;
    color: var(--muted);
  }
  .enc li.winner {
    color: #fff;
    font-weight: 700;
  }
  .enc li.us :global(.name) {
    color: var(--orange);
  }
  .wins {
    font: 800 1.2rem/1 var(--display);
  }
  .games-line {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.9rem;
    margin: 0.35rem 0 0;
    padding-top: 0.4rem;
    border-top: 1px solid var(--line);
    font: 700 0.8rem/1 var(--display);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--dim);
  }
</style>
