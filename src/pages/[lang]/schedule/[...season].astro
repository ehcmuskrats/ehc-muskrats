---
import Base from '../../../layouts/Base.astro';
import GameList from '../../../components/GameList.astro';
import SeasonPicker from '../../../components/SeasonPicker.astro';
import DataCredit from '../../../components/DataCredit.astro';
import VideoEmbed from '../../../components/VideoEmbed.astro';
import { type Lang, LANGS, useT } from '../../../i18n/index.ts';
import { ourSeasons, currentSeasonId, ourGames, sortByDate, highlights, season as getSeason, resultClass, resultCode } from '../../../lib/data.ts';

export function getStaticPaths() {
  return LANGS.flatMap((lang) => [
    { params: { lang, season: undefined } },
    ...ourSeasons.map((s) => ({ params: { lang, season: s.info.id } })),
  ]);
}
const lang = Astro.params.lang as Lang;
const seasonId = Astro.params.season ?? currentSeasonId;
const t = useT(lang);
const s = getSeason(seasonId);
const games = sortByDate(ourGames(seasonId));
const dated = games.filter((g) => g.date);
const tbd = games.filter((g) => !g.date && g.status !== 'final');
const seasonVideos = highlights.items.filter((h) => !h.gameId && h.status === 'not-a-game' && h.season === seasonId);
// Season record line
const rec = { W: 0, L: 0, T: 0 };
for (const g of games) {
  const r = resultCode(g);
  if (r) rec[resultClass(r)]++;
}
const played = rec.W + rec.L + rec.T;
// Phases of the season we actually played in (Grunddurchgang, TOP 4 / LOW 5, Playoffs) for the phase switch.
const phases: { value: string; label: string }[] = [];
for (const d of [...(s?.info.divisions ?? [])].sort((a, b) => a.id - b.id)) {
  if (d.kind === 'playoffs') continue;
  if (games.some((g) => !g.playoff && g.divisionId === d.id)) phases.push({ value: String(d.id), label: d.name });
}
if (games.some((g) => g.playoff)) phases.push({ value: 'playoffs', label: t('common.playoffs') });
---

<Base lang={lang} title={`${t('schedule.title')} ${seasonId.replace('-', '/')}`} path={Astro.params.season ? `schedule/${seasonId}/` : 'schedule/'} active="nav.schedule" leagueData>
  <header class="page-head">
    <span class="tag">{t('common.season')} {seasonId.replace('-', '/')}</span>
    <h1>{t('nav.schedule')}</h1>
    {
      played > 0 && (
        <p class="record tnum">
          <span class="w">{rec.W} W</span>
          <span class="l">{rec.L} L</span>
          {rec.T > 0 && <span class="t">{rec.T} T</span>}
          <span class="dim">· {played} {lang === 'de' ? 'Spiele gespielt' : 'games played'}</span>
        </p>
      )
    }
  </header>

  <SeasonPicker lang={lang} section="schedule" seasons={ourSeasons.map((x) => x.info.id)} current={seasonId} />

  {
    !s?.info.muskratsPlays ? (
      <p class="muted">{t('common.notPlayed')}</p>
    ) : (
      <>
        <div class="controls">
          {phases.length > 1 && (
            <div class="seg phase-seg" role="group" aria-label={t('common.season')} data-filter="phase">
              <button type="button" data-value="all" aria-pressed="true">{t('common.all')}</button>
              {phases.map((p) => (
                <button type="button" data-value={p.value} aria-pressed="false">
                  {p.label}
                </button>
              ))}
            </div>
          )}
          <div class="seg" role="group" aria-label={t('schedule.filterStatus')} data-filter="status">
            <button type="button" data-value="all" aria-pressed="true">{t('common.all')}</button>
            <button type="button" data-value="upcoming" aria-pressed="false">{t('common.upcoming')}</button>
            <button type="button" data-value="played" aria-pressed="false">{t('common.played')}</button>
          </div>
          <div class="seg" role="group" aria-label={t('schedule.filterVenue')} data-filter="venue">
            <button type="button" data-value="all" aria-pressed="true">{t('common.all')}</button>
            <button type="button" data-value="home" aria-pressed="false">{t('common.home')}</button>
            <button type="button" data-value="away" aria-pressed="false">{t('common.away')}</button>
          </div>
        </div>

        <section aria-label={t('schedule.title')}>
          <GameList lang={lang} games={dated} filterable />
        </section>

        {tbd.length > 0 && (
          <section aria-labelledby="h-tbd" data-tbd>
            <div class="sec-head">
              <h2 id="h-tbd">{t('common.dateTbc')}</h2>
            </div>
            <p class="muted small">{t('common.dateTbcNote')}</p>
            <GameList lang={lang} games={tbd} noDate />
          </section>
        )}
      </>
    )
  }

  {
    seasonVideos.length > 0 && (
      <section aria-labelledby="h-vids">
        <div class="sec-head">
          <h2 id="h-vids">{t('schedule.seasonVideos')}</h2>
        </div>
        <div class="grid grid-2">
          {seasonVideos.map((h) => (
            <VideoEmbed lang={lang} video={h.video} />
          ))}
        </div>
      </section>
    )
  }

  <DataCredit lang={lang} video={seasonVideos.length > 0} />
</Base>

<script>
  const state: Record<string, string> = { status: 'all', venue: 'all', phase: 'all' };
  function apply() {
    let visible = 0;
    document.querySelectorAll<HTMLElement>('[data-games] > li').forEach((li) => {
      const ok =
        (state.status === 'all' || li.dataset.status === state.status) &&
        (state.venue === 'all' || li.dataset.venue === state.venue) &&
        (state.phase === 'all' || li.dataset.phase === state.phase);
      li.hidden = !ok;
      if (ok && !li.closest('[data-tbd]')) visible++;
    });
    const tbd = document.querySelector<HTMLElement>('[data-tbd]');
    if (tbd) tbd.hidden = state.status === 'played';
    const empty = document.querySelector<HTMLElement>('.empty-msg');
    if (empty) empty.hidden = visible > 0;
  }
  document.querySelectorAll<HTMLElement>('[data-filter]').forEach((group) => {
    const key = group.dataset.filter!;
    group.querySelectorAll<HTMLButtonElement>('button').forEach((b) =>
      b.addEventListener('click', () => {
        group.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        state[key] = b.dataset.value!;
        if (key === 'phase') history.replaceState(null, '', state.phase === 'all' ? location.pathname : `#${state.phase}`);
        apply();
      }),
    );
  });
  // Deep link: …/schedule/2024-25/#playoffs
  const fromHash = location.hash.slice(1);
  if (fromHash) document.querySelector<HTMLButtonElement>(`[data-filter="phase"] button[data-value="${CSS.escape(fromHash)}"]`)?.click();
</script>

<style>
  .controls .seg {
    flex: 1 1 260px;
  }
  .controls .phase-seg {
    flex-basis: 100%;
  }
  .phase-seg [aria-pressed='true'] {
    background: var(--orange);
    color: var(--ink);
    box-shadow: var(--glow-orange);
  }
  .record {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: baseline;
    margin: 0;
    font: 800 1.15rem/1 var(--display);
    letter-spacing: 0.04em;
  }
  .record .w {
    color: var(--win);
  }
  .record .l {
    color: var(--loss);
  }
  .record .t {
    color: var(--tie);
  }
  .record .dim {
    font-family: var(--font);
    font-weight: 400;
    font-size: 0.85rem;
    letter-spacing: 0;
  }
</style>
