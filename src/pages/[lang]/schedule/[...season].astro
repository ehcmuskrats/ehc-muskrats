---
import Base from '../../../layouts/Base.astro';
import GameList from '../../../components/GameList.astro';
import SeasonPicker from '../../../components/SeasonPicker.astro';
import DataCredit from '../../../components/DataCredit.astro';
import VideoEmbed from '../../../components/VideoEmbed.astro';
import { type Lang, LANGS, useT } from '../../../i18n/index.ts';
import { ourSeasons, currentSeasonId, ourGames, sortByDate, highlights, season as getSeason, resultClass, resultCode, teamName } from '../../../lib/data.ts';
import { isOurTeam } from '../../../config/team.ts';

export function getStaticPaths() {
  return LANGS.flatMap((lang) => [
    { params: { lang, season: undefined } },
    ...ourSeasons.map((s) => ({ params: { lang, season: s.info.id } })),
  ]);
}
const lang = Astro.params.lang as Lang;
const seasonId = Astro.params.season ?? currentSeasonId;
const t = useT(lang);
const s = getSeason(seasonId);
const games = sortByDate(ourGames(seasonId));
const dated = games.filter((g) => g.date);
const tbd = games.filter((g) => !g.date && g.status !== 'final');
const seasonVideos = highlights.items.filter((h) => !h.gameId && h.status === 'not-a-game' && h.season === seasonId);
// Season record line
const rec = { W: 0, L: 0, T: 0 };
for (const g of games) {
  const r = resultCode(g);
  if (r) rec[resultClass(r)]++;
}
const played = rec.W + rec.L + rec.T;
// Phases of the season we actually played in (Grunddurchgang, TOP 4 / LOW 5, Playoffs) for the phase switch.
const phases: { value: string; label: string }[] = [];
for (const d of [...(s?.info.divisions ?? [])].sort((a, b) => a.id - b.id)) {
  if (d.kind === 'playoffs') continue;
  if (games.some((g) => !g.playoff && g.divisionId === d.id)) phases.push({ value: String(d.id), label: d.name });
}
if (games.some((g) => g.playoff)) phases.push({ value: 'playoffs', label: t('common.playoffs') });

// Dated games grouped by phase (one section per phase when the season had more than one).
const phaseOf = (g: (typeof games)[number]) => (g.playoff ? 'playoffs' : String(g.divisionId));
const phaseGroups = phases.length > 1 ? phases.map((p) => ({ ...p, games: dated.filter((g) => phaseOf(g) === p.value) })) : [];

// Playoff series: one block per encounter we played in, in date order, with the series score from our side.
type Series = { label: string; games: typeof dated; us: number; them: number; decided: 'won' | 'lost' | null; bestOf: number; final: boolean };
const series: Series[] = [];
for (const ph of s?.playoffs?.phases ?? []) {
  for (const enc of ph.encounters) {
    const encGames = dated.filter((g) => enc.gameIds.includes(g.id));
    if (!encGames.length) continue;
    const ours = enc.teams.find((x) => isOurTeam(x.team));
    const theirs = enc.teams.filter((x) => !isOurTeam(x.team));
    const anyWinner = enc.teams.some((x) => x.winner);
    series.push({
      label: enc.label || ph.label,
      games: encGames,
      us: ours?.wins ?? 0,
      them: Math.max(0, ...theirs.map((x) => x.wins)),
      decided: anyWinner ? (ours?.winner ? 'won' : 'lost') : null,
      bestOf: enc.bestOf,
      final: ph.round === 'final',
    });
  }
}
// Opponents played this season, A–Z, for the opponent picker.
const oppMap = new Map<number, (typeof games)[number]['home']>();
for (const g of games) {
  const o = isOurTeam(g.home) ? g.away : g.home;
  oppMap.set(o.id, o);
}
const opponents = [...oppMap.values()].sort((a, b) => teamName(a).localeCompare(teamName(b)));
// Any playoff game not found in the bracket still gets shown.
const inSeries = new Set(series.flatMap((x) => x.games.map((g) => g.id)));
const looseRound = dated.filter((g) => g.playoff && !inSeries.has(g.id));
---

<Base lang={lang} title={`${t('schedule.title')} ${seasonId.replace('-', '/')}`} path={Astro.params.season ? `schedule/${seasonId}/` : 'schedule/'} active="nav.schedule" leagueData>
  <header class="page-head">
    <span class="tag">{t('common.season')} {seasonId.replace('-', '/')}</span>
    <h1>{t('nav.schedule')}</h1>
    {
      played > 0 && (
        <p class="record tnum">
          <span class="w">{rec.W} W</span>
          <span class="l">{rec.L} L</span>
          {rec.T > 0 && <span class="t">{rec.T} T</span>}
          <span class="dim">· {played} {lang === 'de' ? 'Spiele gespielt' : 'games played'}</span>
        </p>
      )
    }
  </header>

  <SeasonPicker lang={lang} section="schedule" seasons={ourSeasons.map((x) => x.info.id)} current={seasonId} />

  {
    !s?.info.muskratsPlays ? (
      <p class="muted">{t('common.notPlayed')}</p>
    ) : (
      <>
        <div class="controls">
          {phases.length > 1 && (
            <div class="seg phase-seg" role="group" aria-label={t('common.season')} data-filter="phase">
              <button type="button" data-value="all" aria-pressed="true">{t('common.all')}</button>
              {phases.map((p) => (
                <button type="button" data-value={p.value} aria-pressed="false">
                  {p.label}
                </button>
              ))}
            </div>
          )}
          <div class="seg" role="group" aria-label={t('schedule.filterStatus')} data-filter="status">
            <button type="button" data-value="all" aria-pressed="true">{t('common.all')}</button>
            <button type="button" data-value="upcoming" aria-pressed="false">{t('common.upcoming')}</button>
            <button type="button" data-value="played" aria-pressed="false">{t('common.played')}</button>
          </div>
          {opponents.length > 1 && (
            <div class="opp-pick">
              <label for="opp-filter" class="visually-hidden">
                {t('common.opponent')}
              </label>
              <select id="opp-filter" data-opp-filter>
                <option value="all">
                  {t('common.opponent')}: {t('common.all')}
                </option>
                {opponents.map((o) => (
                  <option value={String(o.id)}>{teamName(o)}</option>
                ))}
              </select>
            </div>
          )}
        </div>
        <p class="h2h tnum" data-h2h hidden></p>

        {phaseGroups.length === 0 ? (
          <section aria-label={t('schedule.title')}>
            <GameList lang={lang} games={dated} filterable />
          </section>
        ) : (
          <>
            {phaseGroups.map((pg) => (
              <section class="phase-sec" data-phase-section={pg.value} aria-labelledby={`h-ph-${pg.value}`}>
                <div class="sec-head">
                  <h2 id={`h-ph-${pg.value}`}>{pg.label}</h2>
                  <span class="count tnum">{pg.games.length}</span>
                </div>
                {pg.value !== 'playoffs' ? (
                  <GameList lang={lang} games={pg.games} />
                ) : (
                  <>
                    {series.map((sr) => (
                      <div class="series">
                        {sr.final && sr.decided === 'won' && (
                          <div class="champs" role="note">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                              <path d="M8 4h8v5a4 4 0 0 1-8 0zM8 6H5a3 3 0 0 0 3 4M16 6h3a3 3 0 0 1-3 4M12 13v4M8.5 20h7M10 17h4" />
                            </svg>
                            <div>
                              <p class="champs-title">{lang === 'de' ? 'Meister' : 'Champions'} {seasonId.replace('-', '/')}</p>
                              <p class="champs-sub">
                                {lang === 'de'
                                  ? `Finalserie ${sr.us}:${sr.them} gegen ${teamName(sr.games[0] ? (isOurTeam(sr.games[0].home) ? sr.games[0].away : sr.games[0].home) : sr.games[0])} gewonnen.`
                                  : `Won the final series ${sr.us}:${sr.them} against ${teamName(sr.games[0] ? (isOurTeam(sr.games[0].home) ? sr.games[0].away : sr.games[0].home) : sr.games[0])}.`}
                              </p>
                            </div>
                          </div>
                        )}
                        <p class="series-head">
                          <span class="sl">{sr.label}</span>
                          {sr.bestOf > 1 && (
                            <span class="ss tnum">
                              {t('schedule.series')} {sr.us}:{sr.them}
                            </span>
                          )}
                          {sr.decided && (
                            <span class={`res res-${sr.decided === 'won' ? 'W' : 'L'}`}>
                              {t(sr.decided === 'won' ? 'schedule.seriesWon' : 'schedule.seriesLost')}
                            </span>
                          )}
                        </p>
                        <GameList lang={lang} games={sr.games} />
                      </div>
                    ))}
                    {looseRound.length > 0 && <GameList lang={lang} games={looseRound} />}
                  </>
                )}
              </section>
            ))}
            <p class="muted empty-msg" hidden>
              {t('common.noGames')}
            </p>
          </>
        )}

        {tbd.length > 0 && (
          <section aria-labelledby="h-tbd" data-tbd>
            <div class="sec-head">
              <h2 id="h-tbd">{t('common.dateTbc')}</h2>
            </div>
            <p class="muted small">{t('common.dateTbcNote')}</p>
            <GameList lang={lang} games={tbd} noDate />
          </section>
        )}
      </>
    )
  }

  {
    seasonVideos.length > 0 && (
      <section aria-labelledby="h-vids">
        <div class="sec-head">
          <h2 id="h-vids">{t('schedule.seasonVideos')}</h2>
        </div>
        <div class="grid grid-2">
          {seasonVideos.map((h) => (
            <VideoEmbed lang={lang} video={h.video} />
          ))}
        </div>
      </section>
    )
  }

  <DataCredit lang={lang} video={seasonVideos.length > 0} />
</Base>

<script>
  const state: Record<string, string> = { status: 'all', opp: 'all', phase: 'all' };
  const lang = document.documentElement.lang;
  function apply() {
    let visible = 0;
    const h2h = { W: 0, L: 0, T: 0, gf: 0, ga: 0, gp: 0 };
    document.querySelectorAll<HTMLElement>('[data-games] > li').forEach((li) => {
      const ok =
        (state.status === 'all' || li.dataset.status === state.status) &&
        (state.opp === 'all' || li.dataset.opp === state.opp) &&
        (state.phase === 'all' || li.dataset.phase === state.phase);
      li.hidden = !ok;
      if (ok && !li.closest('[data-tbd]')) visible++;
      if (ok && li.dataset.res) {
        h2h[li.dataset.res as 'W' | 'L' | 'T']++;
        h2h.gf += Number(li.dataset.gf ?? 0);
        h2h.ga += Number(li.dataset.ga ?? 0);
        h2h.gp++;
      }
    });
    // Head-to-head line when an opponent is picked, e.g. "vs VIHC: 2 W · 1 L · Tore 14:11".
    const line = document.querySelector<HTMLElement>('[data-h2h]');
    const sel = document.querySelector<HTMLSelectElement>('[data-opp-filter]');
    if (line && sel) {
      line.hidden = state.opp === 'all' || h2h.gp === 0;
      const name = sel.options[sel.selectedIndex]?.text ?? '';
      const parts = [`${h2h.W} W`, `${h2h.L} L`, ...(h2h.T ? [`${h2h.T} T`] : [])].join(' · ');
      const el = (tag: string, text: string) => Object.assign(document.createElement(tag), { textContent: text });
      line.replaceChildren(el('b', `vs ${name}`), el('span', parts), el('span', `${lang === 'de' ? 'Tore' : 'Goals'} ${h2h.gf}:${h2h.ga}`));
    }
    // Hide phase sections / playoff series blocks that have nothing left to show.
    document.querySelectorAll<HTMLElement>('[data-phase-section], .series').forEach((sec) => {
      sec.hidden = !sec.querySelector('[data-games] > li:not([hidden])');
    });
    const tbd = document.querySelector<HTMLElement>('[data-tbd]');
    if (tbd) tbd.hidden = state.status === 'played';
    const empty = document.querySelector<HTMLElement>('.empty-msg');
    if (empty) empty.hidden = visible > 0;
  }
  document.querySelectorAll<HTMLElement>('[data-filter]').forEach((group) => {
    const key = group.dataset.filter!;
    group.querySelectorAll<HTMLButtonElement>('button').forEach((b) =>
      b.addEventListener('click', () => {
        group.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        state[key] = b.dataset.value!;
        if (key === 'phase') history.replaceState(null, '', state.phase === 'all' ? location.pathname : `#${state.phase}`);
        apply();
      }),
    );
  });
  document.querySelector<HTMLSelectElement>('[data-opp-filter]')?.addEventListener('change', (e) => {
    state.opp = (e.target as HTMLSelectElement).value;
    apply();
  });
  // Deep link: …/schedule/2024-25/#playoffs
  const fromHash = location.hash.slice(1);
  if (fromHash) document.querySelector<HTMLButtonElement>(`[data-filter="phase"] button[data-value="${CSS.escape(fromHash)}"]`)?.click();
</script>

<style>
  /* Championship moment: only shown above a won final series. */
  .champs {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.9rem;
    padding: 1rem 1.2rem;
    border-radius: 14px;
    background: linear-gradient(110deg, rgba(247, 122, 26, 0.22), rgba(247, 122, 26, 0.06) 60%), var(--panel);
    box-shadow:
      inset 0 0 0 1px rgba(247, 122, 26, 0.45),
      0 10px 40px -12px rgba(247, 122, 26, 0.55);
  }
  .champs::before {
    /* a light sheen that sweeps across, like a trophy catching the arena lights */
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, transparent 30%, rgba(255, 255, 255, 0.22) 45%, transparent 60%);
    transform: translateX(-100%);
    animation: sheen 3.6s ease-in-out 0.6s infinite;
    pointer-events: none;
  }
  @keyframes sheen {
    0% {
      transform: translateX(-100%);
    }
    45%,
    100% {
      transform: translateX(100%);
    }
  }
  .champs svg {
    flex: none;
    width: 44px;
    height: 44px;
    fill: none;
    stroke: var(--orange);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    filter: drop-shadow(0 0 10px rgba(247, 122, 26, 0.6));
    animation: lift 3.6s ease-in-out 0.6s infinite;
  }
  @keyframes lift {
    0%,
    100% {
      transform: none;
    }
    20% {
      transform: translateY(-4px) rotate(-6deg);
    }
    35% {
      transform: none;
    }
  }
  .champs-title {
    margin: 0;
    font: 800 clamp(1.5rem, 6vw, 2.1rem) / 1 var(--display);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--orange);
  }
  .champs-sub {
    margin: 0.3rem 0 0;
    color: var(--text);
    font-size: 0.9rem;
  }
  .opp-pick {
    flex: 1 1 220px;
  }
  .opp-pick select {
    width: 100%;
    min-height: 44px;
  }
  .h2h {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    align-items: baseline;
    margin: -0.25rem 0 1rem;
    padding: 0.7rem 1rem;
    border-radius: 12px;
    background: var(--panel);
    box-shadow: inset 3px 0 0 var(--orange);
    font: 800 1.05rem/1.2 var(--display);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .h2h :global(span) {
    color: var(--muted);
  }
  .controls .seg {
    flex: 1 1 260px;
  }
  .controls .phase-seg {
    flex-basis: 100%;
  }
  .count {
    font: 800 1.4rem/1 var(--display);
    color: var(--dim);
  }
  .series + .series {
    margin-top: 1.1rem;
  }
  .series-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.75rem;
    margin: 0 0 0.5rem;
  }
  .sl {
    font: 800 1.05rem/1 var(--display);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--orange);
  }
  .ss {
    font: 800 1.05rem/1 var(--display);
    color: #fff;
  }
  .series-head .res {
    width: auto;
    padding: 0 0.5em;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .phase-seg [aria-pressed='true'] {
    background: var(--orange);
    color: var(--ink);
    box-shadow: var(--glow-orange);
  }
  .record {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: baseline;
    margin: 0;
    font: 800 1.15rem/1 var(--display);
    letter-spacing: 0.04em;
  }
  .record .w {
    color: var(--win);
  }
  .record .l {
    color: var(--loss);
  }
  .record .t {
    color: var(--tie);
  }
  .record .dim {
    font-family: var(--font);
    font-weight: 400;
    font-size: 0.85rem;
    letter-spacing: 0;
  }
</style>
