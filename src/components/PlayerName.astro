---
// Player name, linked to the profile when the player is one of ours.
import type { PlayerRef } from '../types/models.ts';
import { type Lang, href } from '../i18n/index.ts';
import { playerSlug } from '../lib/data.ts';
interface Props {
  lang: Lang;
  p: PlayerRef | null;
  ours?: boolean;
  number?: boolean;
}
const { lang, p, ours = false, number = false } = Astro.props;
const slug = p && ours ? playerSlug(p.id) : null;
const label = p ? `${number && p.number != null ? `#${p.number} ` : ''}${p.first} ${p.last}`.trim() : '';
---

{p ? slug ? <a href={href(lang, `players/${slug}/`)}>{label}</a> : <span>{label}</span> : <span class="muted">–</span>}
