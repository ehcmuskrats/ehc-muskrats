---
// Schedule rows, designed for phones: date block | opponent | score.
import type { GameSummary } from '../types/models.ts';
import { type Lang, t, href } from '../i18n/index.ts';
import { RESULT_FULL } from '../i18n/abbr.ts';
import { opponent, ourScore, resultCode, resultClass, side, gamesWithHighlights, hasGamePage } from '../lib/data.ts';
import Team from './Team.astro';
interface Props {
  lang: Lang;
  games: GameSummary[];
  /** Games without a fixed date. */
  noDate?: boolean;
  filterable?: boolean;
}
const { lang, games, noDate = false, filterable = false } = Astro.props;
const WD = { de: ['So', 'Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa'], en: ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'] };
const MON = {
  de: ['Jän', 'Feb', 'Mär', 'Apr', 'Mai', 'Jun', 'Jul', 'Aug', 'Sep', 'Okt', 'Nov', 'Dez'],
  en: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
};
const parts = (iso: string) => {
  const [y, m, d] = iso.split('-').map(Number);
  return { d, mon: MON[lang][m - 1], wd: WD[lang][new Date(Date.UTC(y, m - 1, d)).getUTCDay()] };
};
---

<ol class="games" data-games>
  {
    games.map((g) => {
      const opp = opponent(g);
      const s = side(g);
      const { us, them } = ourScore(g);
      const r = resultCode(g);
      const played = g.status === 'final' || g.status === 'live';
      const linkable = hasGamePage(g);
      const p = g.date && !noDate ? parts(g.date) : null;
      const Row = linkable ? 'a' : 'div';
      return (
        <li
          data-status={played ? 'played' : 'upcoming'}
          data-venue={s}
          data-phase={g.playoff ? 'playoffs' : String(g.divisionId)}
          data-opp={String(opp.id)}
          data-res={r ? resultClass(r) : undefined}
          data-gf={played && us != null ? String(us) : undefined}
          data-ga={played && them != null ? String(them) : undefined}
        >
          <Row class={`row ${played ? 'played' : ''}`} href={linkable ? href(lang, `games/${g.id}/`) : undefined}>
            <span class="when">
              {p ? (
                <>
                  <span class="wd">{p.wd}</span>
                  <span class="d tnum">{p.d}</span>
                  <span class="mon">{p.mon}</span>
                </>
              ) : (
                <span class="tbd">{t(lang, 'common.tbd')}</span>
              )}
            </span>
            <span class="who">
              <span class="meta">
                <span class={`ha ${s}`}>{s === 'home' ? t(lang, 'common.home') : t(lang, 'common.away')}</span>
                {g.playoff && <span class="po">{g.playoff.encounter ?? g.playoff.roundLabel}</span>}
              </span>
              <Team team={opp} size={28} />
              <span class="venue">
                {g.time && !played ? `${g.time} · ` : ''}
                {g.venue?.replace(/^Wien - /, '') ?? ''}
              </span>
            </span>
            <span class="score">
              {played && us != null ? (
                <>
                  <span class="sc tnum">
                    {us}
                    <i>:</i>
                    {them}
                  </span>
                  <span class="badges">
                    {r && (
                      <span class={`res res-${resultClass(r)}`} title={RESULT_FULL[r][lang]}>
                        {r}
                      </span>
                    )}
                    {g.status === 'live' && <span class="live">{t(lang, 'common.live')}</span>}
                    {gamesWithHighlights.has(g.id) && (
                      <svg class="play" viewBox="0 0 24 24" role="img" aria-label={t(lang, 'schedule.hasHighlights')}>
                        <title>{t(lang, 'schedule.hasHighlights')}</title>
                        <circle cx="12" cy="12" r="11" />
                        <path d="M10 7.8l6 4.2-6 4.2z" />
                      </svg>
                    )}
                  </span>
                </>
              ) : (
                <span class="kick tnum">{g.time ?? '–'}</span>
              )}
            </span>
          </Row>
        </li>
      );
    })
  }
</ol>
{games.length === 0 && <p class="muted">{t(lang, 'common.noGames')}</p>}
{filterable && <p class="muted empty-msg" hidden>{t(lang, 'common.noGames')}</p>}

<style>
  .games {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .row {
    display: grid;
    grid-template-columns: 52px 1fr auto;
    gap: 12px;
    align-items: center;
    min-height: 76px;
    padding: 10px 14px 10px 10px;
    border-radius: 12px;
    background: var(--panel);
    box-shadow: var(--highlight);
    color: var(--text);
    position: relative;
    overflow: hidden;
    transition:
      background 0.15s,
      box-shadow 0.2s;
  }
  a.row:hover {
    color: var(--text);
    background: var(--panel-2);
    box-shadow: var(--glow-blue);
  }
  .when {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    align-self: stretch;
    border-radius: 9px;
    background: rgba(var(--fg-rgb), 0.04);
    font-family: var(--display);
    text-transform: uppercase;
    line-height: 1;
    padding: 6px 0;
  }
  .wd,
  .mon {
    font-weight: 700;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: var(--dim);
  }
  .d {
    font-weight: 800;
    font-size: 1.6rem;
    color: var(--text);
    margin: 2px 0;
  }
  .tbd {
    text-align: center;
    font-weight: 800;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    color: var(--dim);
  }
  .who {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .who :global(.name) {
    font: 800 1.15rem/1.05 var(--display);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    white-space: normal;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .meta {
    display: flex;
    gap: 8px;
    align-items: center;
    font: 700 0.7rem/1 var(--display);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .ha {
    color: var(--dim);
  }
  .ha.home {
    color: var(--text);
  }
  .po {
    color: var(--accent-text);
  }
  .venue {
    font-size: 0.78rem;
    color: var(--dim);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .score {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 5px;
  }
  .sc {
    font: 800 1.9rem/1 var(--display);
    color: var(--text);
    letter-spacing: 0.02em;
  }
  .sc i {
    font-style: normal;
    color: var(--dim);
    margin: 0 1px;
  }
  .kick {
    font: 800 1.35rem/1 var(--display);
    color: var(--muted);
  }
  .badges {
    display: flex;
    gap: 6px;
    align-items: center;
  }
  .play {
    width: 20px;
    height: 20px;
  }
  .play circle {
    fill: var(--orange);
  }
  .play path {
    fill: var(--ink);
  }
  .live {
    font: 800 0.75rem/1 var(--display);
    letter-spacing: 0.1em;
    color: var(--loss);
    text-transform: uppercase;
  }
  @media (min-width: 720px) {
    .row {
      grid-template-columns: 60px 1fr auto;
      padding: 12px 18px 12px 12px;
    }
    .who :global(.name) {
      font-size: 1.3rem;
    }
  }
</style>
