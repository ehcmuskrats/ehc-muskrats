---
// Click-to-load YouTube embed. No request to YouTube/Google until the visitor clicks:
// the thumbnail is served from our own site (downloaded during sync), and the iframe
// uses youtube-nocookie.com.
import { existsSync } from 'node:fs';
import { type Lang, t, url } from '../i18n/index.ts';
import { TEAM } from '../config/team.ts';
import type { Video } from '../types/models.ts';
interface Props {
  lang: Lang;
  video: Video;
  /** Hide the caption (title + consent note). */
  bare?: boolean;
}
const { lang, video, bare = false } = Astro.props;
const hasThumb = existsSync(`public/thumbs/${video.id}.jpg`);
---

<figure class="video">
  <div class="frame" data-yt={video.id} data-title={video.title}>
    <button type="button" class="play" aria-label={`${t(lang, 'game.watch')}: ${video.title}`}>
      {hasThumb && <img src={url(`thumbs/${video.id}.jpg`)} alt="" loading="lazy" decoding="async" width="480" height="360" />}
      <span class="shade" aria-hidden="true"></span>
      <span class="icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="30" height="30"><path d="M8 5.5v13l11-6.5z" fill="currentColor"></path></svg>
      </span>
      {bare && <span class="vt">{video.title}</span>}
    </button>
  </div>
  {
    !bare && (
      <figcaption>
        <span class="title">{video.title}</span>
        <span class="note">
          {t(lang, 'game.consent')} ·{' '}
          <a href={TEAM.youtube.channelUrl} rel="noopener">
            {t(lang, 'credit.video', { name: TEAM.youtube.creditName })}
          </a>
        </span>
      </figcaption>
    )
  }
</figure>

<script>
  document.querySelectorAll<HTMLElement>('.video .frame[data-yt]').forEach((frame) => {
    frame.querySelector('button')?.addEventListener('click', () => {
      const id = frame.dataset.yt!;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}?autoplay=1&rel=0`;
      iframe.title = frame.dataset.title ?? 'YouTube';
      iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      frame.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>

<style>
  .video {
    margin: 0;
  }
  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 14px 40px -14px rgba(0, 0, 0, 0.8);
  }
  .frame :global(iframe),
  .play {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .play {
    padding: 0;
    cursor: pointer;
    background: linear-gradient(135deg, var(--blue), #0b2e66);
    color: var(--ink);
  }
  .play img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }
  .play:hover img {
    transform: scale(1.03);
  }
  .shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 45%, rgba(5, 11, 24, 0.85));
  }
  .icon {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 64px;
    height: 64px;
    margin: -32px 0 0 -32px;
    display: grid;
    place-items: center;
    padding-left: 3px;
    border-radius: 50%;
    background: var(--orange);
    box-shadow:
      0 0 0 8px rgba(247, 122, 26, 0.25),
      0 10px 30px rgba(0, 0, 0, 0.5);
    transition: transform 0.2s;
  }
  .play:hover .icon,
  .play:focus-visible .icon {
    transform: scale(1.08);
  }
  .vt {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 10px;
    text-align: left;
    color: #fff;
    font: 800 1.05rem/1.1 var(--display);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin-top: 0.65rem;
  }
  .title {
    font: 800 1.1rem/1.15 var(--display);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .note {
    font-size: 0.75rem;
    color: var(--dim);
  }
  .note a {
    color: var(--muted);
  }
</style>
