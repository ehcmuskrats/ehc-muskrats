---
// Table race (#11), MoneyPuck style: x = games played, y = points above a 1-point-per-game pace
// (wins are 2 points in this league, so "pace" is a .500 team). One line per team with a dot per game,
// logos at the end of each line. Our line is the brand yellow; tap a logo to highlight a team.
// Built for phones first: the SVG is drawn at phone proportions and scales up to a capped width.
import { type Lang, url } from '../i18n/index.ts';
import { season as getSeason, teamName } from '../lib/data.ts';
import { teamKey } from '../lib/teams.ts';
import { isOurTeam } from '../config/team.ts';
import type { SeasonId, TeamRef } from '../types/models.ts';

interface Props {
  lang: Lang;
  season: SeasonId;
  divisionId: number;
}
const { lang, season, divisionId } = Astro.props;
const de = lang === 'de';
const s = getSeason(season);
const st = s?.standings.find((x) => x.divisionId === divisionId);
const played = (s?.games ?? [])
  .filter((g) => g.divisionId === divisionId && g.status === 'final' && g.homeScore != null && g.awayScore != null)
  .sort((a, b) => (a.timestamp ?? 0) - (b.timestamp ?? 0));

// Per team: running "points minus games played" after each of its games.
type Team = { key: string; team: TeamRef; pts: number; gp: number; path: number[] };
const teams = new Map<string, Team>();
for (const r of st?.rows ?? []) teams.set(teamKey(r.team), { key: teamKey(r.team), team: r.team, pts: 0, gp: 0, path: [0] });
for (const g of played) {
  const h = teams.get(teamKey(g.home));
  const a = teams.get(teamKey(g.away));
  if (!h || !a) continue;
  const extra = g.overtime || g.shootout;
  const hs = g.homeScore!;
  const as = g.awayScore!;
  const hp = hs > as ? 2 : hs === as || extra ? 1 : 0;
  const ap = as > hs ? 2 : hs === as || extra ? 1 : 0;
  for (const [t, p] of [
    [h, hp],
    [a, ap],
  ] as const) {
    t.pts += p;
    t.gp += 1;
    t.path.push(t.pts - t.gp);
  }
}
const list = [...teams.values()].filter((t) => t.gp > 0);
const maxGp = Math.max(1, ...list.map((t) => t.gp));
const vals = list.flatMap((t) => t.path);
const yMax = Math.max(2, ...vals);
const yMin = Math.min(-2, ...vals);

// Phone-first canvas; the CSS caps the width on desktop so labels stay readable.
const W = 360;
const H = 360;
const L = 26; // left axis
const R = 38; // room for logos
const T = 10;
const B = 22;
const x = (i: number) => L + (i / maxGp) * (W - L - R);
const y = (v: number) => T + ((yMax - v) / (yMax - yMin)) * (H - T - B);
const yStep = yMax - yMin > 12 ? 4 : 2;
const yTicks: number[] = [];
for (let v = Math.ceil(yMin / yStep) * yStep; v <= yMax; v += yStep) yTicks.push(v);
const xStep = maxGp > 15 ? 5 : maxGp > 6 ? 2 : 1;
const xTicks: number[] = [];
for (let v = 0; v <= maxGp; v += xStep) xTicks.push(v);

// Distinct colours that work on dark and light; ours is the brand yellow.
const PALETTE = ['#4766c4', '#d1495b', '#2a9d8f', '#8e6fd8', '#e07a5f', '#3d9be9', '#6a994e', '#c05299', '#8d99ae', '#00a6a6', '#b5838d'];
let pi = 0;
const lines = list
  .sort((a, b) => Number(isOurTeam(a.team)) - Number(isOurTeam(b.team)))
  .map((t, i) => {
    const us = isOurTeam(t.team);
    const color = us ? 'var(--orange)' : PALETTE[pi++ % PALETTE.length];
    const pts = t.path.map((v, k) => [x(k), y(v)] as const);
    return { ...t, us, color, dashed: !us && i % 2 === 1, d: pts.map(([px, py], k) => `${k ? 'L' : 'M'}${px.toFixed(1)} ${py.toFixed(1)}`).join(' '), pts, end: pts.at(-1)! };
  });
// End logos: keep them from overlapping (min 15 units apart), nudged within the chart.
const ends = [...lines].sort((a, b) => a.end[1] - b.end[1]).map((l) => ({ l, y: l.end[1] }));
for (let i = 1; i < ends.length; i++) if (ends[i].y - ends[i - 1].y < 19) ends[i].y = ends[i - 1].y + 19;
const overflow = (ends.at(-1)?.y ?? 0) - (H - B);
if (overflow > 0) for (const e of ends) e.y -= overflow;
const endY = new Map(ends.map((e) => [e.l.key, e.y]));
const show = maxGp >= 2 && list.length >= 3;
---

{
  show && (
    <section class="chart-sec" aria-labelledby={`h-bump-${divisionId}`} data-pagefind-ignore>
      <div class="sec-head">
        <h2 id={`h-bump-${divisionId}`}>{de ? 'Tabellenverlauf' : 'Table race'}</h2>
      </div>
      <div class="panel race" data-race>
        <svg viewBox={`0 0 ${W} ${H}`} role="group" aria-label={de ? 'Punkte über einem Punkt pro Spiel, je Team und Spiel' : 'Points above one point per game, per team and game'}>
          {yTicks.map((v) => (
            <g>
              <line x1={L} x2={W - R} y1={y(v)} y2={y(v)} class:list={['grid', { zero: v === 0 }]} />
              <text x={L - 5} y={y(v) + 3} class="ax" text-anchor="end">
                {v > 0 ? `+${v}` : v}
              </text>
            </g>
          ))}
          {xTicks.map((v) => (
            <text x={x(v)} y={H - 6} class="ax" text-anchor="middle">
              {v}
            </text>
          ))}
          {lines.map((l) => (
            <g class:list={['ln', { us: l.us }]} data-key={l.key} style={`--c:${l.color}`}>
              <path d={l.d} class:list={{ dash: l.dashed }} />
              {l.pts.slice(1).map(([px, py]) => (
                <circle cx={px} cy={py} r={l.us ? 2.6 : 1.9} />
              ))}
              {endY.get(l.key)! !== l.end[1] && <line x1={l.end[0]} y1={l.end[1]} x2={l.end[0] + 6} y2={endY.get(l.key)} class="lead" />}
            </g>
          ))}
          {lines.map((l) => (
            <g class:list={['logo', { us: l.us }]} data-key={l.key} role="button" tabindex="0" aria-label={teamName(l.team)}>
              <title>{teamName(l.team)}</title>
              <circle cx={l.end[0] + 17} cy={endY.get(l.key)} r="10.5" class="ring" />
              {l.team.logo ? (
                <image href={url(l.team.logo)} x={l.end[0] + 8} y={endY.get(l.key)! - 9} width="18" height="18" preserveAspectRatio="xMidYMid meet" />
              ) : (
                <text x={l.end[0] + 17} y={endY.get(l.key)! + 3} class="ax" text-anchor="middle">
                  {(l.team.short || teamName(l.team)).slice(0, 3)}
                </text>
              )}
            </g>
          ))}
        </svg>
        <p class="axis-lab small dim">
          <span>{de ? '↑ Punkte über Schnitt (1 Punkt pro Spiel)' : '↑ Points above 1 point per game'}</span>
          <span>{de ? 'Spiele →' : 'Games →'}</span>
        </p>
      </div>
      <p class="small dim note">
        {de
          ? 'Steigt eine Linie, holt das Team mehr als einen Punkt pro Spiel (Sieg 2, Unentschieden 1). Logo antippen, um ein Team hervorzuheben.'
          : 'A rising line means more than one point per game (win 2, tie 1). Tap a logo to highlight a team.'}
      </p>
    </section>
  )
}

<script>
  document.querySelectorAll<HTMLElement>('[data-race]').forEach((root) => {
    let cur: string | null = null;
    const pick = (key: string | null) => {
      cur = cur === key ? null : key;
      root.classList.toggle('picking', !!cur);
      root.querySelectorAll<SVGGElement>('g.ln, g.logo').forEach((g) => g.classList.toggle('on', g.dataset.key === cur));
    };
    root.querySelectorAll<SVGGElement>('g.logo').forEach((g) => {
      g.addEventListener('click', () => pick(g.dataset.key!));
      g.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          pick(g.dataset.key!);
        }
      });
    });
  });
</script>

<style>
  .race {
    padding: 12px 8px 8px;
  }
  .race svg {
    display: block;
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    overflow: visible;
  }
  .grid {
    stroke: var(--line);
    stroke-width: 0.6;
  }
  .grid.zero {
    stroke: var(--line-strong);
    stroke-width: 1;
  }
  .ax {
    font: 600 8.5px var(--font);
    fill: var(--dim);
  }
  .ln path {
    fill: none;
    stroke: var(--c);
    stroke-width: 1.6;
    stroke-linejoin: round;
    stroke-linecap: round;
    opacity: 0.85;
  }
  .ln path.dash {
    stroke-dasharray: 2 2.5;
  }
  .ln circle {
    fill: var(--c);
  }
  .ln.us path {
    stroke-width: 2.8;
    opacity: 1;
  }
  .ln .lead {
    stroke: var(--c);
    stroke-width: 0.6;
    opacity: 0.6;
  }
  .ring {
    fill: var(--panel);
    stroke: var(--line-strong);
    stroke-width: 0.8;
  }
  .logo {
    cursor: pointer;
  }
  .logo.us .ring {
    stroke: var(--orange);
    stroke-width: 1.4;
  }
  .logo:focus-visible .ring {
    stroke: var(--text);
    stroke-width: 1.6;
  }
  .picking .ln {
    opacity: 0.18;
  }
  .picking .ln.on,
  .picking .ln.us {
    opacity: 1;
  }
  .picking .ln.on path {
    stroke-width: 2.8;
  }
  .picking .logo.on .ring {
    stroke: var(--c, var(--text));
    stroke-width: 1.8;
  }
  .axis-lab {
    display: flex;
    justify-content: space-between;
    margin: 0.3rem 0.25rem 0;
  }
  .note {
    margin-top: 0.6rem;
  }
</style>
