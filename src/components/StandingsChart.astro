---
// Table position over the season (#11): a bump chart, one line per team, logos at the end of each line.
// Positions are replayed game day by game day from the results (win 2, tie or OT/SO loss 1, as in this
// league); the last point uses the official table. Logos sit in an HTML column so they stay readable on
// phones; tap or hover a logo to highlight that team.
import { type Lang, url, formatDate } from '../i18n/index.ts';
import { season as getSeason, teamName } from '../lib/data.ts';
import { teamKey } from '../lib/teams.ts';
import { isOurTeam } from '../config/team.ts';
import type { SeasonId, TeamRef } from '../types/models.ts';

interface Props {
  lang: Lang;
  season: SeasonId;
  divisionId: number;
}
const { lang, season, divisionId } = Astro.props;
const de = lang === 'de';
const s = getSeason(season);
const st = s?.standings.find((x) => x.divisionId === divisionId);
const played = (s?.games ?? [])
  .filter((g) => g.divisionId === divisionId && g.status === 'final' && g.homeScore != null && g.awayScore != null && g.date)
  .sort((a, b) => (a.timestamp ?? 0) - (b.timestamp ?? 0));
// One point per week: teams play on different dates, so per-date positions would just zigzag.
const weekOf = (iso: string) => {
  const d = new Date(iso + 'T12:00:00Z');
  d.setUTCDate(d.getUTCDate() - ((d.getUTCDay() + 6) % 7));
  return d.toISOString().slice(0, 10);
};
const days = [...new Set(played.map((g) => weekOf(g.date!)))];

type Row = { key: string; team: TeamRef; pts: number; gf: number; ga: number };
const rows = new Map<string, Row>();
for (const r of st?.rows ?? []) rows.set(teamKey(r.team), { key: teamKey(r.team), team: r.team, pts: 0, gf: 0, ga: 0 });
const series = new Map<string, number[]>([...rows.keys()].map((k) => [k, []]));
for (const day of days) {
  for (const g of played.filter((x) => weekOf(x.date!) === day)) {
    const h = rows.get(teamKey(g.home));
    const a = rows.get(teamKey(g.away));
    if (!h || !a) continue;
    const hs = g.homeScore!;
    const as = g.awayScore!;
    h.gf += hs;
    h.ga += as;
    a.gf += as;
    a.ga += hs;
    const extra = g.overtime || g.shootout;
    if (hs > as) {
      h.pts += 2;
      if (extra) a.pts += 1;
    } else if (as > hs) {
      a.pts += 2;
      if (extra) h.pts += 1;
    } else {
      h.pts += 1;
      a.pts += 1;
    }
  }
  const order = [...rows.values()].sort((x, y) => y.pts - x.pts || y.gf - y.ga - (x.gf - x.ga) || y.gf - x.gf || teamName(x.team).localeCompare(teamName(y.team)));
  order.forEach((r, i) => series.get(r.key)!.push(i + 1));
}
// Last point = official table.
for (const r of st?.rows ?? []) {
  const list = series.get(teamKey(r.team));
  if (list?.length) list[list.length - 1] = r.rank;
}
const n = rows.size;
const W = 640;
const H = n * 28;
const padY = 12;
const x = (i: number) => (days.length <= 1 ? W / 2 : (i / (days.length - 1)) * (W - 8) + 4);
const y = (rank: number) => padY + ((rank - 1) / Math.max(1, n - 1)) * (H - 2 * padY);
const lines = [...series.entries()].map(([k, pts]) => ({
  key: k,
  team: rows.get(k)!.team,
  us: isOurTeam(rows.get(k)!.team),
  d: pts.map((r, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)} ${y(r).toFixed(1)}`).join(' '),
  last: pts.at(-1) ?? n,
}));
const show = days.length >= 2 && n >= 3;
---

{
  show && (
    <section class="chart-sec" aria-labelledby={`h-bump-${divisionId}`} data-pagefind-ignore>
      <div class="sec-head">
        <h2 id={`h-bump-${divisionId}`}>{de ? 'Tabellenverlauf' : 'Table over time'}</h2>
      </div>
      <div class="panel bump" data-bump style={`--ch:${n * 28}px`}>
        <div class="plot">
          <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" role="img" aria-label={de ? 'Tabellenplatz je Woche' : 'Table position per week'}>
            {Array.from({ length: n }, (_, i) => (
              <line x1="0" x2={W} y1={y(i + 1)} y2={y(i + 1)} class="grid" />
            ))}
            {lines
              .filter((l) => !l.us)
              .map((l) => (
                <path d={l.d} class="ln" data-key={l.key} vector-effect="non-scaling-stroke" />
              ))}
            {lines
              .filter((l) => l.us)
              .map((l) => (
                <path d={l.d} class="ln us" data-key={l.key} vector-effect="non-scaling-stroke" />
              ))}
          </svg>
          <div class="axis small dim">
            <span>{formatDate(lang, played[0]?.date)}</span>
            <span>{`${days.length} ${de ? 'Wochen' : 'weeks'}`}</span>
            <span>{formatDate(lang, played.at(-1)?.date)}</span>
          </div>
        </div>
        <ol class="logos">
          {[...lines]
            .sort((a, b) => a.last - b.last)
            .map((l) => (
              <li style={`top:${((y(l.last) / H) * 100).toFixed(2)}%`}>
                <button type="button" data-key={l.key} class:list={{ us: l.us }} title={`${l.last}. ${teamName(l.team)}`} aria-pressed={l.us ? 'true' : 'false'}>
                  {l.team.logo ? (
                    <img src={url(l.team.logo)} alt={teamName(l.team)} width="24" height="24" loading="lazy" />
                  ) : (
                    <span class="ph">{(l.team.short || teamName(l.team)).slice(0, 3)}</span>
                  )}
                </button>
              </li>
            ))}
        </ol>
      </div>
      <p class="small dim note">
        {de
          ? 'Platzierung nach jeder Woche, aus den Ergebnissen berechnet (Sieg 2 Punkte, Unentschieden 1). Logo antippen, um ein Team hervorzuheben.'
          : 'Position after each week, calculated from the results (win 2 points, tie 1). Tap a logo to highlight a team.'}
      </p>
    </section>
  )
}

<script>
  document.querySelectorAll<HTMLElement>('[data-bump]').forEach((root) => {
    const pick = (key: string | null) => {
      root.classList.toggle('picking', !!key);
      root.querySelectorAll<SVGPathElement>('path.ln').forEach((p) => p.classList.toggle('on', p.dataset.key === key));
      root.querySelectorAll<HTMLButtonElement>('.logos button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.key === key || (!key && b.classList.contains('us')))));
    };
    let cur: string | null = null;
    root.querySelectorAll<HTMLButtonElement>('.logos button').forEach((b) =>
      b.addEventListener('click', () => {
        cur = cur === b.dataset.key ? null : b.dataset.key!;
        pick(cur);
      }),
    );
  });
</script>

<style>
  .bump {
    display: grid;
    grid-template-columns: 1fr 34px;
    gap: 8px;
    padding-right: 10px;
  }
  .plot {
    min-width: 0;
  }
  .plot svg {
    display: block;
    width: 100%;
    height: var(--ch);
  }
  .grid {
    stroke: var(--line);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .ln {
    fill: none;
    stroke: rgba(var(--fg-rgb), 0.22);
    stroke-width: 2;
    stroke-linejoin: round;
    transition: stroke 0.2s, opacity 0.2s;
  }
  .ln.us {
    stroke: var(--orange);
    stroke-width: 3.5;
  }
  .picking .ln {
    opacity: 0.35;
  }
  .picking .ln.on {
    opacity: 1;
    stroke: var(--blue-hi);
    stroke-width: 3.5;
  }
  .picking .ln.us.on {
    stroke: var(--orange);
  }
  .axis {
    display: flex;
    justify-content: space-between;
    margin-top: 0.4rem;
  }
  .logos {
    position: relative;
    height: var(--ch);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .logos li {
    position: absolute;
    left: 0;
    transform: translateY(-50%);
  }
  .logos button {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    cursor: pointer;
    opacity: 0.8;
  }
  .logos button[aria-pressed='true'] {
    opacity: 1;
    box-shadow: 0 0 0 2px var(--orange);
  }
  .logos img {
    width: 24px;
    height: 24px;
    object-fit: contain;
  }
  .ph {
    font: 800 0.6rem/1 var(--display);
  }
  .note {
    margin-top: 0.6rem;
  }
</style>
