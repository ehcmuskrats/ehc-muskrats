---
// Match preview for an upcoming game (#14, #22): where and when, directions and calendar, both teams'
// table position and form, and the head-to-head history. Everything comes from the synced WEHV data.
import Team from './Team.astro';
import CalendarButton from './CalendarButton.astro';
import { type Lang, href, formatDate } from '../i18n/index.ts';
import { RESULT_FULL } from '../i18n/abbr.ts';
import { resultClass, teamName } from '../lib/data.ts';
import { teamKey, form, standing, headToHead, tally, type TeamResult } from '../lib/teams.ts';
import { venueFor, hallOf, directionsUrl } from '../config/venues.ts';
import { isOurTeam } from '../config/team.ts';
import type { GameSummary } from '../types/models.ts';

interface Props {
  lang: Lang;
  game: GameSummary;
}
const { lang, game: g } = Astro.props;
const de = lang === 'de';
const opp = isOurTeam(g.home) ? g.away : g.home;
const oppKey = teamKey(opp);
const before = g.timestamp ?? Infinity;
const teamsSides = [g.home, g.away].map((t) => {
  const k = teamKey(t);
  return { team: t, key: k, form: form(k, g.season, 5, before), st: standing(k, g.season, g.divisionId) };
});
const h2h = headToHead(oppKey);
const h2hT = tally(h2h);
const venue = venueFor(g.venue);
const hall = hallOf(g.venue);
const dirs = directionsUrl(g.venue);
const stake = (() => {
  const [a, b] = teamsSides.map((x) => x.st?.row);
  if (!a || !b) return null;
  const diff = Math.abs(a.pts - b.pts);
  const ahead = a.pts >= b.pts ? g.home : g.away;
  if (diff === 0) return de ? 'Beide Teams sind punktegleich.' : 'Both teams are level on points.';
  return de
    ? `${teamName(ahead)} liegt ${diff} ${diff === 1 ? 'Punkt' : 'Punkte'} voran.`
    : `${teamName(ahead)} lead by ${diff} ${diff === 1 ? 'point' : 'points'}.`;
})();
const chip = (r: TeamResult) => r.result;
---

<section class="preview" aria-labelledby="h-prev">
  <div class="sec-head">
    <h2 id="h-prev">{de ? 'Vorschau' : 'Preview'}</h2>
  </div>

  <div class="panel where">
    <div class="where-main">
      <p class="w-when">
        <strong>{formatDate(lang, g.date, { weekday: true })}</strong>
        {g.time && <> · <strong>{g.time}</strong></>}
      </p>
      {
        g.venue && (
          <p class="w-venue">
            {venue?.name ?? g.venue.replace(/^Wien - /, '')}
            {hall && <span class="hall">{hall}</span>}
          </p>
        )
      }
      {venue && <p class="small dim">{venue.address}</p>}
    </div>
    <div class="where-actions">
      {
        dirs && (
          <a class="btn btn-ghost" href={dirs} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 21s-6.5-5.6-6.5-11A6.5 6.5 0 0 1 18.5 10c0 5.4-6.5 11-6.5 11z" />
              <circle cx="12" cy="10" r="2.3" />
            </svg>
            {de ? 'Route' : 'Directions'}
          </a>
        )
      }
      <CalendarButton lang={lang} game={g} />
    </div>
    <a class="mdlink" href={href(lang, 'matchday/')}>
      {de ? 'Zuschauer willkommen, Eintritt frei · Anreise & Infos' : 'Spectators welcome, free entry · Getting there'} →
    </a>
  </div>

  <div class="cmp">
    {
      teamsSides.map((x) => (
        <div class:list={['panel', 'side', { us: isOurTeam(x.team) }]}>
          <div class="side-head">
            <Team team={x.team} logoOnly size={34} />
            <span class="nm">{teamName(x.team)}</span>
          </div>
          {x.st ? (
            <p class="pos">
              <span class="big tnum">#{x.st.row.rank}</span>
              <span class="small dim tnum">
                {x.st.row.pts} PTS · {x.st.row.gp} GP · {x.st.row.gf}:{x.st.row.ga}
              </span>
            </p>
          ) : (
            <p class="small dim">{de ? 'Noch keine Tabelle' : 'No standings yet'}</p>
          )}
          <div class="form" aria-label={de ? 'Letzte 5 Spiele' : 'Last 5 games'}>
            {x.form.length ? (
              x.form.map((r) => (
                <span class={`res res-${resultClass(chip(r))}`} title={`${RESULT_FULL[r.result][lang]} ${r.gf}:${r.ga} vs ${teamName(r.opponent)}`}>
                  {r.result}
                </span>
              ))
            ) : (
              <span class="small dim">{de ? 'Noch keine Spiele' : 'No games yet'}</span>
            )}
          </div>
        </div>
      ))
    }
  </div>
  {stake && <p class="stake small">{stake}</p>}

  <div class="panel h2h">
    <p class="eyebrow">{de ? 'Direkte Duelle' : 'Head to head'}</p>
    {
      h2h.length ? (
        <>
          <p class="h2h-sum tnum">
            <span class="w">{h2hT.w} W</span>
            <span class="l">{h2hT.l} L</span>
            {h2hT.t > 0 && <span class="t">{h2hT.t} T</span>}
            <span class="dim small">
              · {h2hT.gf}:{h2hT.ga} {de ? 'Tore' : 'goals'} · {h2hT.gp} {de ? 'Spiele' : 'games'}
            </span>
          </p>
          <ul class="h2h-list">
            {h2h.slice(0, 5).map((r) => (
              <li>
                <a href={href(lang, `games/${r.game.id}/`)}>
                  <span class="d small dim tnum">{formatDate(lang, r.game.date)}</span>
                  <span class={`res res-${resultClass(r.result)}`}>{r.result}</span>
                  <span class="sc tnum">{r.gf}:{r.ga}</span>
                  <span class="small dim">{r.game.playoff ? 'Playoffs' : r.game.divisionName}</span>
                </a>
              </li>
            ))}
          </ul>
          <a class="more small" href={href(lang, `teams/${oppKey}/`)}>
            {de ? `Alles über ${teamName(opp)}` : `All about ${teamName(opp)}`} →
          </a>
        </>
      ) : (
        <p class="small dim">{de ? 'Erstes Duell mit diesem Team.' : 'First meeting with this team.'}</p>
      )
    }
  </div>
</section>

<style>
  .preview {
    margin-top: 1.5rem;
  }
  .where {
    display: grid;
    gap: 0.9rem;
  }
  .w-when {
    margin: 0;
    font: 700 1.25rem/1.2 var(--display);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .w-venue {
    margin: 0.2rem 0 0;
    font-weight: 600;
  }
  .hall {
    margin-left: 0.5rem;
    padding: 0.1rem 0.45rem;
    border-radius: 6px;
    background: rgba(var(--accent-rgb), 0.18);
    color: var(--accent-ink);
    font: 800 0.8rem/1.4 var(--display);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .where-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .where-actions .btn svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
  }
  .mdlink {
    font-size: 0.88rem;
    color: var(--muted);
  }
  .cmp {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 10px;
  }
  .side {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }
  .side.us {
    box-shadow: inset 0 0 0 1px rgba(var(--accent-rgb), 0.45);
  }
  .side-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }
  .nm {
    font-weight: 700;
    font-size: 0.9rem;
    line-height: 1.2;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .pos {
    display: flex;
    flex-direction: column;
    margin: 0;
  }
  .pos .big {
    font: 800 2rem/1 var(--display);
  }
  .form {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .stake {
    margin: 0.6rem 0 0;
    color: var(--muted);
  }
  .h2h {
    margin-top: 10px;
  }
  .h2h-sum {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem;
    margin: 0.3rem 0 0.6rem;
    font: 800 1.3rem/1 var(--display);
  }
  .h2h-sum .w {
    color: var(--win);
  }
  .h2h-sum .l {
    color: var(--loss);
  }
  .h2h-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .h2h-list a {
    display: grid;
    grid-template-columns: 6.2rem auto 3rem 1fr;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    border-top: 1px solid var(--line);
    color: var(--text);
  }
  .sc {
    font: 800 1.05rem/1 var(--display);
  }
  .more {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 0.25rem;
  }
</style>
