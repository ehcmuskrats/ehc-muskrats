---
// Head-to-head card for an opponent page (inspired by club "Head 2 Head" match graphics, minus photos):
// table positions, the all-time win split, this season's record and goal difference side by side,
// power play / penalty kill rings and both teams' last five results. Phone first: a 3-column grid
// (us · label · them) that stays readable at 360px.
import Team from './Team.astro';
import { roundName } from '../i18n/rounds.ts';
import { type Lang, formatNumber } from '../i18n/index.ts';
import { teamName, currentSeasonId } from '../lib/data.ts';
import { form, standing, teamStats, headToHead, tally, type TeamInfo, type TeamResult } from '../lib/teams.ts';
import { TEAM } from '../config/team.ts';
import type { SeasonId, TeamRef } from '../types/models.ts';

interface Props {
  lang: Lang;
  o: TeamInfo;
  season: SeasonId;
  usTeam: TeamRef;
}
const { lang, o, season, usTeam } = Astro.props;
const de = lang === 'de';
const sides = [
  { key: 'ehc-muskrats', team: usTeam, us: true },
  { key: o.key, team: o.team, us: false },
].map((x) => ({
  ...x,
  st: standing(x.key, season),
  sp: teamStats(x.key, season),
  frm: form(x.key, season, 5).reverse(), // oldest → newest, newest on the outside edge
}));
const [us, them] = sides;
const all = tally(headToHead(o.key));
const totalW = all.w + all.l || 1;
const rec = (x: (typeof sides)[number]) => (x.st ? [x.st.row.w + x.st.row.otw, x.st.row.l + x.st.row.otl, x.st.row.ties].join('–') : '–');
const gd = (x: (typeof sides)[number]) => (x.st ? x.st.row.gf - x.st.row.ga : null);
const sign = (n: number | null) => (n == null ? '–' : n > 0 ? `+${n}` : String(n));
const pct = (n: number | null | undefined) => (n == null ? null : Math.round(n));
const res = (r: TeamResult) => (r.result === 'W' || r.result === 'OTW' ? 'W' : r.result === 'T' ? 'T' : 'L');
const ring = (v: number | null) => {
  const C = 2 * Math.PI * 15;
  return { dash: v == null ? 0 : (Math.min(100, v) / 100) * C, C };
};
const label = season.replace('-', '/');
const isCurrent = season === currentSeasonId;
/** Short season tag for the centre labels, e.g. 26/27. */
const tag = label.replace(/^20/, '').replace('/20', '/');
---

<section class="h2h-card" aria-label={de ? `EHC Muskrats gegen ${o.name}` : `EHC Muskrats vs ${o.name}`}>
  <div class="row heads">
    {
      sides.map((x, i) => (
        <div class:list={['head', i ? 'r' : 'l', { us: x.us }]}>
          <Team team={x.team} logoOnly size={56} />
          <span class="rank tnum" title={x.st ? `${roundName(x.st.division, lang)} ${label}` : ''}>
            {x.st ? `#${x.st.row.rank}` : '–'}
          </span>
        </div>
      ))
    }
    <div class="mid">
      <span class="vs">VS</span>
      <span class="cap">{de ? `Tabelle ${label}` : `Table ${label}`}</span>
    </div>
  </div>
  {
    !isCurrent && (
      <p class="past">
        {de ? `Zuletzt in der Liga: ${label}. Die Werte unten sind aus dieser Saison.` : `Last in the league: ${label}. The figures below are from that season.`}
      </p>
    )
  }

  <div class="split" aria-label={de ? `Siege im direkten Duell: Muskrats ${all.w}, ${o.name} ${all.l}` : `Head-to-head wins: Muskrats ${all.w}, ${o.name} ${all.l}`}>
    <span class="a tnum" style={`flex:${Math.max(all.w, 0.0001) / totalW}`}>{all.w}</span>
    <span class="b tnum" style={`flex:${Math.max(all.l, 0.0001) / totalW}`}>{all.l}</span>
  </div>
  <p class="split-cap">
    {de ? 'Siege im direkten Duell · alle Saisonen' : 'Head-to-head wins · all seasons'}
    {all.t > 0 && <span class="dim">{de ? ` · ${all.t} Unentschieden` : ` · ${all.t} ties`}</span>}
  </p>

  <div class="row stat">
    <div class="v l">
      <strong class="tnum">{us.st?.row.gp ?? '–'}</strong>
      <span class="sub tnum">({rec(us)})</span>
    </div>
    <div class="lab">{de ? 'Spiele' : 'Games'}<span class="stag">{tag}</span><span>W–L–T</span></div>
    <div class="v r">
      <strong class="tnum">{them.st?.row.gp ?? '–'}</strong>
      <span class="sub tnum">({rec(them)})</span>
    </div>
  </div>
  <div class="row stat">
    <div class="v l">
      <strong class="tnum">{sign(gd(us))}</strong>
      <span class="sub tnum">{us.st ? `(${us.st.row.gf}/${us.st.row.ga})` : ''}</span>
    </div>
    <div class="lab">{de ? 'Tordifferenz' : 'Goal diff.'}<span class="stag">{tag}</span><span>GF/GA</span></div>
    <div class="v r">
      <strong class="tnum">{sign(gd(them))}</strong>
      <span class="sub tnum">{them.st ? `(${them.st.row.gf}/${them.st.row.ga})` : ''}</span>
    </div>
  </div>

  {
    (us.sp || them.sp) && (
      <div class="rings">
        {sides.map((x) => (
          <div class:list={['ring-pair', { us: x.us }]}>
            {(
              [
                ['PP', pct(x.sp?.ppPct)],
                ['PK', pct(x.sp?.pkPct)],
              ] as const
            ).map(([k, v]) => {
              const r = ring(v);
              return (
                <figure class="ring">
                  <svg viewBox="0 0 40 40" aria-hidden="true">
                    <circle cx="20" cy="20" r="15" class="track" />
                    <circle cx="20" cy="20" r="15" class="fill" stroke-dasharray={`${r.dash} ${r.C}`} transform="rotate(-90 20 20)" />
                    <text x="20" y="23.5" text-anchor="middle" class="pv">
                      {v == null ? '–' : `${v}%`}
                    </text>
                  </svg>
                  <figcaption>{k === 'PP' ? 'Power Play' : 'Penalty Kill'}</figcaption>
                </figure>
              );
            })}
          </div>
        ))}
        <p class="rings-cap">
          Special Teams <span class="stag">{tag}</span>
        </p>
      </div>
    )
  }

  <div class="row last5">
    {
      sides.map((x, i) => (
        <div class:list={['chips', i ? 'r' : 'l']}>
          {x.frm.length ? (
            x.frm.map((r) => (
              <span class={`res res-${res(r)}`} title={`${r.gf}:${r.ga} vs ${teamName(r.opponent)}`}>
                {res(r)}
              </span>
            ))
          ) : (
            <span class="dim small">–</span>
          )}
        </div>
      ))
    }
    <div class="lab">{de ? 'Letzte 5' : 'Last 5'}<span class="stag">{tag}</span></div>
  </div>
</section>

<style>
  .h2h-card {
    margin: 0.75rem 0 1rem;
    padding: 16px 12px 14px;
    border-radius: var(--radius);
    background:
      radial-gradient(120% 80% at 50% 0%, rgba(var(--accent-rgb), 0.07), transparent 60%),
      var(--panel);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 8px;
  }
  .heads {
    position: relative;
  }
  .head {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .head.r {
    grid-column: 3;
    grid-row: 1;
    flex-direction: row-reverse;
  }
  .head.l {
    grid-column: 1;
    grid-row: 1;
  }
  .mid {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }
  .vs {
    font: 800 1.5rem/1 var(--display);
    color: var(--dim);
  }
  .cap,
  .lab span {
    font: 700 0.62rem/1.2 var(--display);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .rank {
    font: 800 2rem/1 var(--display);
  }
  .head.us .rank {
    color: var(--accent-text);
  }
  .split {
    display: flex;
    height: 30px;
    margin-top: 16px;
    border-radius: 8px;
    overflow: hidden;
    font: 800 1.05rem/30px var(--display);
  }
  .split span {
    min-width: 2.2rem;
    padding: 0 10px;
  }
  .split .a {
    background: var(--orange);
    color: var(--on-accent);
  }
  .split .b {
    background: var(--panel-hi);
    color: var(--text);
    text-align: right;
  }
  .past {
    margin: 0.7rem 0 0;
    padding: 0.45rem 0.7rem;
    border-radius: 8px;
    background: rgba(var(--fg-rgb), 0.06);
    font-size: 0.8rem;
    text-align: center;
    color: var(--muted);
  }
  .lab .stag {
    margin: 0.2rem 0 0.15rem;
    padding: 0.12rem 0.4rem;
    border-radius: 4px;
    background: rgba(var(--accent-rgb), 0.16);
    color: var(--text);
    letter-spacing: 0.08em;
  }
  .split-cap {
    margin: 0.4rem 0 0.9rem;
    text-align: center;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .stat {
    padding: 0.55rem 0;
    border-top: 1px solid var(--line);
  }
  .v {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .v.r {
    align-items: flex-end;
    text-align: right;
  }
  .v strong {
    font: 800 1.7rem/1 var(--display);
  }
  .sub {
    font-size: 0.78rem;
    color: var(--muted);
  }
  .lab {
    display: flex;
    flex-direction: column;
    align-items: center;
    font: 700 0.78rem/1.15 var(--display);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: center;
    min-width: 5.5rem;
  }
  .rings-cap {
    grid-column: 1 / -1;
    margin: 0.1rem 0 0;
    text-align: center;
    font: 700 0.62rem/1 var(--display);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .rings-cap .stag {
    margin-left: 0.3rem;
    padding: 0.12rem 0.4rem;
    border-radius: 4px;
    background: rgba(var(--accent-rgb), 0.16);
    color: var(--text);
  }
  .rings {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    padding: 0.7rem 0 0.4rem;
    border-top: 1px solid var(--line);
  }
  .ring-pair {
    display: flex;
    justify-content: center;
    gap: 6px;
  }
  .ring {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
  }
  .ring svg {
    width: 62px;
    height: 62px;
  }
  .track {
    fill: none;
    stroke: var(--panel-hi);
    stroke-width: 4;
  }
  .fill {
    fill: none;
    stroke: var(--blue-hi);
    stroke-width: 4;
    stroke-linecap: round;
  }
  .ring-pair.us .fill {
    stroke: var(--orange);
  }
  .pv {
    font: 800 10px var(--display);
    fill: var(--text);
  }
  .ring figcaption {
    font: 700 0.6rem/1 var(--display);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .last5 {
    padding-top: 0.6rem;
    border-top: 1px solid var(--line);
  }
  .chips {
    display: flex;
    gap: 2px;
    min-width: 0;
  }
  .chips.l {
    grid-column: 1;
    grid-row: 1;
  }
  .chips.r {
    grid-column: 3;
    grid-row: 1;
    justify-content: flex-end;
  }
  .last5 .lab {
    min-width: 3.6rem;
    grid-column: 2;
    grid-row: 1;
  }
  .chips :global(.res) {
    min-width: 19px;
    height: 22px;
    padding: 0 2px;
    font-size: 0.72rem;
  }
</style>
